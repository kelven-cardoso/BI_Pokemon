table Golpes

	column Tipo
		dataType: string
		summarizeBy: none
		sourceColumn: Tipo

	column Categoria
		dataType: string
		summarizeBy: none
		sourceColumn: Categoria

	column Papel
		dataType: string
		summarizeBy: none
		sourceColumn: Papel

	column Nome
		dataType: string
		summarizeBy: none
		sourceColumn: Nome

	column Poder
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Poder

	column Precisao
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Precisao

	column Prioridade
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Prioridade

	partition Golpes = m
		mode: import
		source =
				// Golpes da Arena: 4 por tipo (forte/médio, físico F / especial E) + golpes de prioridade.
				// Curados à mão (a PokeAPI não tem nomes em português). Precisao 0 = nunca erra.
				let
				    Fonte = #table(
				        type table [Tipo = text, Categoria = text, Papel = text, Nome = text, Poder = Int64.Type, Precisao = Int64.Type, Prioridade = Int64.Type],
