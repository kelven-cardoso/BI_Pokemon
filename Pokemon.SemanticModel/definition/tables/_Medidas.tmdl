	measure '<HTML> Arena' = ```

			VAR _pk = CONCATENATEX(
			    ALL(Pokemon),
			    "[" & Pokemon[PokemonId] & ",'" & SUBSTITUTE(Pokemon[Nome], "'", "\'") & "'," & Pokemon[SpeciesId]
			  & ",'" & Pokemon[Tipo1Slug] & "','" & Pokemon[Tipo2Slug] & "',"
			  & COALESCE(Pokemon[HP], 1) & "," & COALESCE(Pokemon[Ataque], 1) & "," & COALESCE(Pokemon[Defesa], 1) & ","
			  & COALESCE(Pokemon[AtqEsp], 1) & "," & COALESCE(Pokemon[DefEsp], 1) & "," & COALESCE(Pokemon[Velocidade], 1) & ","
			  & IF(Pokemon[IsDefault], 1, 0) & "]",
			    ",", Pokemon[OrdemDex], ASC
			)
			VAR _ef = CONCATENATEX(
			    FILTER(ALL(Eficacia), Eficacia[Fator] <> 1),
			    "'" & Eficacia[Ataque] & ">" & Eficacia[Defesa] & "':" & FORMAT(Eficacia[Fator], "0.0#", "en-US"),
			    ","
			)
			VAR _gp = CONCATENATEX(
			    ALL(Golpes),
			    "['" & Golpes[Tipo] & "','" & Golpes[Categoria] & "','" & Golpes[Papel] & "','" & SUBSTITUTE(Golpes[Nome], "'", "\'")
			  & "'," & Golpes[Poder] & "," & Golpes[Precisao] & "," & Golpes[Prioridade] & "]",
			    ","
			)
			VAR _tp = CONCATENATEX(ALL(Tipos), Tipos[TipoSlug] & ":['" & Tipos[Tipo] & "','" & Tipos[Cor] & "']", ",", Tipos[Ordem], ASC)
			VAR _versao = COUNTROWS(ALL(Pokemon))
			VAR _dados = "window.ARENA_DADOS={v:" & _versao & ",pk:[" & _pk & "],ef:{" & _ef & "},gp:[" & _gp & "],tp:{" & _tp & "}};"
			VAR _motor =
			"/* Arena Pokémon: motor de batalha 1x1 e Time de 3 (com troca), rodando dentro do visual HTML Content.
			   Os dados vêm de window.ARENA_DADOS (montado pela medida DAX <HTML> Arena):
			     pk: [id, nome, especie, tipo1, tipo2, hp, atk, def, spa, spd, spe, padrao]
			     ef: { 'ataque>defesa': fator }   (só fatores diferentes de 1)
			     gp: [tipo, categoria F/E, papel forte/medio/prio, nome, poder, precisao (0 = nunca erra), prioridade]
			     tp: { slug: [nome PT, cor] }
			   O estado fica em window.__arena: se o Power BI redesenhar o visual, a batalha continua.
			   Não use aspas duplas neste arquivo (ele vira uma string DAX). */
			(function () {
			  var D = window.ARENA_DADOS;
			  var raiz = document.getElementById('arena-raiz');
			  if (!D || !raiz) { return; }

			  var NIVEL = 50;
			  var SPR = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/';

			  /* ---------- dados ---------- */
			  var P = {}, LISTA = [];
			  D.pk.forEach(function (r) {
			    var p = { id: r[0], nome: r[1], esp: r[2], t: r[4] ? [r[3], r[4]] : [r[3]],
