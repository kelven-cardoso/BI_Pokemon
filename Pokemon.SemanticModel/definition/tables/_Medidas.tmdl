			      msg: 'Clique no mapa e use as setas (ou WASD) para andar. O mato alto esconde Pokémon!',
			      bolsa: { poke: 10, grande: 5, ultra: 3, fruta: 3 }, caixa: [], vistos: {}, enc: 0, fugas: 0, shinies: 0, lendarios: 0, luta: null, tecla: null };
