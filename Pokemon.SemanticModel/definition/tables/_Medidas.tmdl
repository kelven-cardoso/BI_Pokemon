table _Medidas

	measure '<CSS> Tipos' = ```

			"
			.bg-normal { background-color: #A8A878; } .c-normal { color: #A8A878; } .fl-normal { fill: #A8A878; stroke: #A8A878; } .bc-normal { border-color: #A8A878; } .gl-normal { background-image: radial-gradient(circle, rgba(168,168,120,0.55) 0%, rgba(168,168,120,0.18) 38%, rgba(168,168,120,0) 68%); } .sf-normal { background-color: rgba(168,168,120,0.16); } .sh-normal { box-shadow: 0 0 22px rgba(168,168,120,0.45); }
