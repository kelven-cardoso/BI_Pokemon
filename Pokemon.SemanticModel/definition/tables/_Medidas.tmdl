			  }
			  raiz.onclick = function (ev) {
			    var el = ev.target.closest('[data-acao]'); if (!el || el.classList.contains('off')) { return; }
			    var acao = el.getAttribute('data-acao'), l = el.getAttribute('data-lado');
			    switch (acao) {
			      case 'modo': S.modo = +el.getAttribute('data-m'); ['j', 'o'].forEach(function (x) { S.time[x] = S.time[x].slice(0, tamanhoTime()); }); render(); break;
			      case 'lado': S.lado = l; render(); break;
			      case 'tipo': var t = el.getAttribute('data-t'); S.tipo = S.tipo === t ? '' : t; render(); break;
			      case 'gen': S.gen = +el.getAttribute('data-g'); render(); break;
			      case 'add':
			        var id = +el.getAttribute('data-id'), lado = S.lado;
			        if (S.time[lado].length >= tamanhoTime()) { lado = lado === 'j' ? 'o' : 'j'; }
			        if (S.time[lado].length < tamanhoTime() && S.time[lado].indexOf(id) < 0) {
			          S.time[lado].push(id);
			          if (S.time[lado].length >= tamanhoTime() && lado === 'j') { S.lado = 'o'; } else { S.lado = lado; }
			        }
			        render(); break;
			      case 'tirar': ev.stopPropagation(); S.time[l].splice(+el.getAttribute('data-i'), 1); S.lado = l; render(); break;
			      case 'aleatorio': ev.stopPropagation(); sortear(l); render(); break;
			      case 'batalhar': iniciarBatalha(); break;
			      case 'golpe': executarTurno({ tipo: 'golpe', idx: +el.getAttribute('data-i') }); break;
			      case 'trocar':
			        var i = +el.getAttribute('data-i');
			        if (S.escolha === 'forcada') { S.escolha = null; S.ocupado = true; entrar('j', i).then(function () { S.ocupado = false; S.msg = 'O que <b>' + esc(ativo(S.B.j).p.nome) + '</b> vai fazer?'; render(); }); }
			        else { executarTurno({ tipo: 'troca', idx: i }); }
			        break;
			      case 'transformar':
			        var op = opcoesTransformar(S.B.j)[+el.getAttribute('data-i')];
			        if (op && !S.ocupado) {
			          S.ocupado = true;
			          transformar('j', op).then(function () { S.ocupado = false; S.msg = 'O que <b>' + esc(ativo(S.B.j).p.nome) + '</b> vai fazer?'; render(); });
			        }
			        break;
			      case 'auto': S.auto = !S.auto; render(); if (S.auto) { proximoAuto(); } break;
			      case 'simular':
			        S.sim = rodarSimulacoes(1000);
			        registrar(`Simulação: você venceu <b>${S.sim.j.toFixed(1)}%</b> de 1.000 batalhas.`);
			        var box = $('ar-sim"
			& "'); if (box) { box.innerHTML = simHtml(); }
			        break;
			      case 'revanche': iniciarBatalha(); break;
			      case 'novo': S.tela = 'selecao'; S.B = null; S.auto = false; S.fim = null; S.escolha = null; S.ocupado = false; render(); break;
			    }
			  };
			  if (!window.__arenaResize) { window.__arenaResize = true; window.addEventListener('resize', function () { K.escala(raiz); }); }
			
			  window.__arenaApi = { simular: simular, golpesDe: golpesDe, statusDe: statusDe, opcoesTransformar: opcoesTransformar, aplicarForma: aplicarForma, desfazerGmax: desfazerGmax, novoLado: novoLado };
			  render();
			  if (S.auto && S.tela === 'batalha' && !S.ocupado) { proximoAuto(); }
			})();
			"
			RETURN
			    "<div id='app-raiz'></div><script>" & _dados & "</script><script>" & _motor & "</script>"
		displayFolder: <HTML>

	measure '<CSS> Arena' =
			
			"#htmlContent { margin: 0; padding: 0; height: 100vh; overflow: hidden; font-family: 'Segoe UI', sans-serif; color: #E9ECF2; background: #0B0E14; }
			.htmlViewerEntry { height: 100vh; }
			#app-raiz { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #0B0E14; }
			.pk-palco { position: absolute; left: 0; top: 0; width: 1280px; height: 720px; transform-origin: 0 0; overflow: hidden; background: radial-gradient(circle at 50% 30%, #1A2130, #0B0E14 70%); }
			.pk-ico { display: inline-block; vertical-align: middle; border-radius: 50%; }
			.pk-chip { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 800; color: #fff; padding: 2px 9px 2px 3px; border-radius: 999px; background: var(--c); margin: 0 4px 3px 0; text-shadow: 0 1px 1px rgba(0,0,0,.35); }
			.bt { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 34px; padding: 0 18px; border-radius: 999px; font-size: 12px; font-weight: 800; letter-spacing: .05em; cursor: pointer; user-select: none; transition: transform .12s, filter .12s, box-shadow .12s; white-space: nowrap; }
			.bt:hover { transform: translateY(-1px); filter: brightness(1.12); }
			.bt.off { opacity: .35; pointer-events: none; }
			.bt-sec { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); color: #E9ECF2; }
			.bt-sec.on { background: rgba(255,203,5,.16); border-color: #FFCB05; color: #FFCB05; }
			.bt-gold { background: #FFCB05; color: #11151D; box-shadow: 0 0 18px rgba(255,203,5,.35); }
			.bt-go { height: 48px; padding: 0 44px; font-size: 17px; letter-spacing: .14em; background: linear-gradient(90deg, #FF5A36, #FFCB05); color: #11151D; box-shadow: 0 0 28px rgba(255,140,40,.5); animation: pulsa 2s ease-in-out infinite; }
			.bt-go.off { animation: none; }
			@keyframes pulsa { 0%, 100% { box-shadow: 0 0 20px rgba(255,140,40,.4); } 50% { box-shadow: 0 0 38px rgba(255,160,40,.75); } }
			.topo { position: absolute; left: 380px; right: 24px; top: 10px; height: 40px; display: flex; align-items: center; justify-content: space-between; z-index: 5; }
			.titulo { text-align: right; }
			.titulo b { display: block; font-size: 22px; font-weight: 900; letter-spacing: .26em; color: #fff; line-height: 1.1; }
			.titulo span { font-size: 10px; color: #8A93A3; font-weight: 600; letter-spacing: .06em; }
			.vidro { border-radius: 18px; background: linear-gradient(160deg, rgba(30,36,48,.92), rgba(14,17,24,.94)); border: 1px solid rgba(255,255,255,.08); box-shadow: inset 0 1px 0 rgba(255,255,255,.06), 0 18px 40px rgba(0,0,0,.35); }
			::-webkit-scrollbar { width: 6px; height: 6px; } ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.2); border-radius: 6px; } ::-webkit-scrollbar-track { background: transparent; }
			
			/* partículas de fundo por tipo (iguais às da Pokédex) */
			.fx { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
			.fx i { position: absolute; display: block; opacity: 0; animation-iteration-count: infinite; animation-timing-function: linear; }
			.fx-water i, .fx-poison i, .fx-normal i { top: auto !important; bottom: -30px; border-radius: 50%; animation-name: bolha; animation-timing-function: ease-in-out; }
			.fx-water i { border: 1.5px solid rgba(190,215,255,.60); background: radial-gradient(circle at 32% 30%, rgba(255,255,255,.70) 0 12%, rgba(120,160,255,.12) 40%, rgba(104,144,240,.05) 70%); }
			.fx-poison i { border: 1.5px solid rgba(220,150,230,.55); background: radial-gradient(circle at 32% 30%, rgba(255,255,255,.55) 0 12%, rgba(160,64,160,.30) 45%, rgba(160,64,160,.08) 70%); }
			.fx-normal i { background: rgba(255,255,255,.22); }
			@keyframes bolha { 0% { transform: translate(0,0) scale(.7); opacity: 0; } 10% { opacity: .9; } 50% { transform: translate(18px,-380px) scale(1.2); } 90% { opacity: .8; } 100% { transform: translate(-10px,-780px) scale(1.5); opacity: 0; } }
			.fx-fire i { top: auto !important; bottom: -10px; width: 4px !important; height: 4px !important; border-radius: 50%; background: #FFD27A; box-shadow: 0 0 6px 2px rgba(255,"
			& "140,40,.85), 0 0 14px 4px rgba(255,80,20,.35); animation-name: brasa; animation-timing-function: ease-out; }
			@keyframes brasa { 0% { transform: translate(0,0) scale(1); opacity: 0; } 8% { opacity: 1; } 30% { transform: translate(-14px,-200px) scale(.9); } 60% { transform: translate(16px,-420px) scale(.7); opacity: .9; } 100% { transform: translate(-6px,-680px) scale(.2); opacity: 0; } }
			.fx-electric i { width: 18px !important; height: 50px !important; filter: drop-shadow(0 0 6px rgba(248,208,48,.95)); animation-name: raiofx; animation-timing-function: steps(1, end); }
			.fx-electric i::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, #FFFBD0, #F8D030); clip-path: polygon(55% 0, 18% 56%, 45% 56%, 28% 100%, 86% 40%, 58% 40%, 76% 0); }
			@keyframes raiofx { 0%, 100% { opacity: 0; } 3% { opacity: 1; } 5% { opacity: .1; } 7% { opacity: 1; } 10% { opacity: 0; } }
			.fx-grass i, .fx-ice i, .fx-rock i { top: -30px !important; animation-timing-function: ease-in-out; }
			.fx-grass i { width: 10px !important; height: 16px !important; border-radius: 0 100% 0 100%; background: linear-gradient(135deg, #A8E68A, #4E9A2F); animation-name: folhafx; }
			.fx-ice i { border-radius: 50%; background: #fff; box-shadow: 0 0 8px rgba(200,240,255,.9); max-width: 8px; max-height: 8px; animation-name: neve; }
			.fx-rock i { background: #B8A038; clip-path: polygon(20% 0, 80% 10%, 100% 60%, 60% 100%, 0 70%); animation-name: pedrafx; animation-timing-function: cubic-bezier(.5,0,1,1); }
			@keyframes folhafx { 0% { transform: translate(0,0) rotate(0); opacity: 0; } 10% { opacity: .85; } 50% { transform: translate(-60px,380px) rotate(200deg); } 90% { opacity: .7; } 100% { transform: translate(40px,780px) rotate(420deg); opacity: 0; } }
			@keyframes neve { 0% { transform: translate(0,0); opacity: 0; } 10% { opacity: .9; } 50% { transform: translate(30px,380px); } 100% { transform: translate(-20px,780px); opacity: 0; } }
			@keyframes pedrafx { 0% { transform: translate(0,0) rotate(0); opacity: 0; } 5% { opacity: .8; } 100% { transform: translate(20px,780px) rotate(360deg); opacity: .5; } }
			.fx-ghost i { top: auto !important; bottom: -60px; width: 46px !important; height: 46px !important; border-radius: 50%; background: radial-gradient(circle, rgba(170,140,230,.55), rgba(112,88,152,0) 70%); filter: blur(2px); animation-name: alma; animation-timing-function: ease-in-out; }
			@keyframes alma { 0% { transform: translate(0,0) scale(.6); opacity: 0; } 20% { opacity: .85; } 50% { transform: translate(40px,-360px) scale(1.2); } 80% { opacity: .5; } 100% { transform: translate(-30px,-760px) scale(.8); opacity: 0; } }
			.fx-psychic i, .fx-fighting i { width: 30px !important; height: 30px !important; border-radius: 50%; border: 2px solid rgba(248,88,136,.70); animation-name: pulsofx; animation-timing-function: ease-out; }
			.fx-fighting i { border-color: rgba(255,120,60,.70); }
			@keyframes pulsofx { 0% { transform: scale(.2); opacity: 0; } 10% { opacity: .9; } 100% { transform: scale(4); opacity: 0; } }
			.fx-flying i { width: 110px !important; height: 2px !important; border-radius: 2px; background: linear-gradient(90deg, transparent, rgba(225,225,255,.65), transparent); animation-name: ventofx; animation-timing-function: ease-in-out; }
			.fx-ground i { border-radius: 50%; background: rgba(224,192,104,.55); filter: blur(1px); animation-name: poeirafx; }
			.fx-dark i { width: 90px !important; height: 90px !important; border-radius: 50%; background: radial-gradient(circle, rgba(70,50,50,.60), transparent 70%); filter: blur(4px); animation-name: fumaca; animation-timing-function: ease-in-out; }
			@keyframes ventofx { 0% { transform: translateX(-300px); opacity: 0; } 20% { opacity: .8; } 100% { transform: translateX(500px); opacity: 0; } }
			@keyframes poeirafx { 0% { transform: translate(-40px,0); opacity: 0; } 20% { opacity: .7; } 100% { transform: translate(260px,-60px); opacity: 0; } }
			@keyframes fumaca { 0% { transform: translate(0,0) scale(.6); opacity: 0; } 30% { opa"
			& "city: .7; } 100% { transform: translate(120px,-140px) scale(1.6); opacity: 0; } }
			.fx-fairy i, .fx-dragon i, .fx-steel i { width: 12px !important; height: 12px !important; clip-path: polygon(50% 0, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0 50%, 39% 39%); animation-name: brilhofx; animation-timing-function: ease-in-out; }
			.fx-fairy i { background: #FFD6E8; } .fx-dragon i { background: #B9A2FF; } .fx-steel i { background: #EEF3FA; }
			.fx-bug i { width: 5px !important; height: 5px !important; border-radius: 50%; background: #E6F57A; box-shadow: 0 0 10px 3px rgba(200,230,80,.70); animation-name: vagalume; animation-timing-function: ease-in-out; }
			@keyframes brilhofx { 0%, 100% { transform: scale(0) rotate(0); opacity: 0; } 50% { transform: scale(1.4) rotate(90deg); opacity: 1; } }
			@keyframes vagalume { 0% { transform: translate(0,0); opacity: 0; } 25% { transform: translate(30px,-20px); opacity: 1; } 50% { transform: translate(-10px,-50px); opacity: .3; } 75% { transform: translate(-40px,-10px); opacity: 1; } 100% { transform: translate(0,0); opacity: 0; } }
			
			/* controles compartilhados (abas, gerações) */
			.modos { display: flex; gap: 6px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.10); padding: 4px; border-radius: 999px; }
			.modos span { padding: 6px 16px; border-radius: 999px; font-size: 11px; font-weight: 800; color: #C9CFDA; cursor: pointer; white-space: nowrap; transition: background .12s, color .12s; }
			.modos span:hover { color: #fff; background: rgba(255,255,255,.06); }
			.modos span.on { background: #FFCB05; color: #11151D; box-shadow: 0 0 14px rgba(255,203,5,.35); }
			.gens { display: flex; gap: 4px; }
			.gc { flex: 1; text-align: center; font-size: 10px; font-weight: 800; padding: 4px 0; border-radius: 999px; cursor: pointer; color: #C9CFDA; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); }
			.gc:hover { color: #fff; border-color: rgba(255,255,255,.25); }
			.gc.on { background: #FFCB05; color: #11151D; border-color: #FFCB05; }
			.topo { left: 452px; }
			
			/* ================= SELEÇÃO ================= */
			.sel-bg { position: absolute; inset: 0; background: radial-gradient(circle at 18% 60%, rgba(61,140,255,.18), transparent 40%), radial-gradient(circle at 82% 60%, rgba(255,90,54,.16), transparent 40%), repeating-linear-gradient(60deg, rgba(255,255,255,.025) 0 1px, transparent 1px 64px); }
			.modos { display: flex; gap: 6px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.10); padding: 4px; border-radius: 999px; }
			.modos span { padding: 7px 20px; border-radius: 999px; font-size: 12px; font-weight: 800; color: #C9CFDA; cursor: pointer; }
			.modos span.on { background: #FFCB05; color: #11151D; box-shadow: 0 0 16px rgba(255,203,5,.4); }
			.sel-col { position: absolute; top: 60px; width: 270px; height: 572px; box-sizing: border-box; padding: 14px; border-radius: 20px; background: linear-gradient(160deg, rgba(30,36,48,.92), rgba(14,17,24,.94)); border: 1px solid rgba(255,255,255,.08); display: flex; flex-direction: column; gap: 10px; cursor: pointer; transition: box-shadow .2s, border-color .2s; }
			.sel-col-j { left: 16px; border-top: 3px solid #3D8CFF; }
			.sel-col-o { right: 16px; border-top: 3px solid #FF5A36; }
			.sel-col.ativo { box-shadow: 0 0 0 2px #FFCB05, 0 0 34px rgba(255,203,5,.20); }
			.sel-col-tit { display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 900; letter-spacing: .2em; color: #fff; }
			.sel-col-tit em { font-style: normal; font-size: 11px; color: #8A93A3; letter-spacing: .05em; }
			.sel-slots { flex: 1 1 auto; display: flex; flex-direction: column; gap: 10px; }
			.sel-slots.m1 .sl { flex: 1 1 auto; flex-direction: column; justify-content: center; text-align: center; }
			.sel-slots.m1 .sl-arte { width: 200px; height: 200px; }
			.sel-slots.m1 .sl-arte img { width: 200px; height: 200px; }
			.sel-slots.m3 .sl { flex: 1 1 0; }
			.sl { position: relative; border-radius: 16px; display: flex; align-items: center; gap: 10px; padd"
			& "ing: 8px 12px; box-sizing: border-box; overflow: hidden; }
			.sl-vazio { border: 2px dashed rgba(255,255,255,.14); color: #737C8C; font-size: 12px; font-weight: 700; justify-content: center; flex-direction: column; gap: 0; }
			.sl-vazio b { font-size: 30px; font-weight: 300; }
			.sl-cheio { background: radial-gradient(circle at 25% 50%, color-mix(in srgb, var(--c) 45%, transparent), transparent 65%), rgba(255,255,255,.04); border: 1px solid color-mix(in srgb, var(--c) 55%, transparent); }
			.sl-cheio > i { position: absolute; top: 6px; right: 10px; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-style: normal; color: #C9CFDA; background: rgba(0,0,0,.35); font-size: 15px; }
			.sl-cheio > i:hover { background: #E5383B; color: #fff; }
			.sl-arte { width: 112px; height: 112px; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; }
			.sl-arte img { width: 112px; height: 112px; object-fit: contain; filter: drop-shadow(0 8px 10px rgba(0,0,0,.5)); animation: flut 4s ease-in-out infinite; }
			.sl-info b { display: block; font-size: 15px; font-weight: 900; color: #fff; margin-bottom: 4px; }
			.sl-info span { font-size: 10px; color: #8A93A3; font-weight: 700; }
			@keyframes flut { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
			.sel-meio { position: absolute; left: 302px; right: 302px; top: 60px; height: 572px; display: flex; flex-direction: column; gap: 8px; }
			.busca { height: 42px; border-radius: 14px; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.06); color: #fff; padding: 0 16px; font-size: 13px; font-family: inherit; outline: none; }
			.busca:focus { border-color: #FFCB05; box-shadow: 0 0 0 3px rgba(255,203,5,.15); }
			.gens { display: flex; gap: 4px; }
			.gc { flex: 1; text-align: center; font-size: 10px; font-weight: 800; padding: 4px 0; border-radius: 999px; cursor: pointer; color: #C9CFDA; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); }
			.gc.on { background: #FFCB05; color: #11151D; border-color: #FFCB05; }
			.tcs { display: flex; justify-content: space-between; }
			.tc { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; opacity: .55; transition: opacity .12s, transform .12s; }
			.tc:hover { opacity: 1; transform: scale(1.12); }
			.tc.on { opacity: 1; box-shadow: 0 0 0 2px #fff, 0 0 14px var(--c); }
			.grade { flex: 1 1 auto; min-height: 0; overflow-y: auto; display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; align-content: start; padding: 2px 4px 2px 2px; }
			.cd { position: relative; height: 104px; border-radius: 14px; background: linear-gradient(180deg, color-mix(in srgb, var(--c) 22%, #1A2030), #161B26); border: 1px solid #283041; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding-bottom: 6px; cursor: pointer; transition: transform .12s, border-color .12s, box-shadow .12s; }
			.cd:hover { transform: translateY(-3px); border-color: var(--c); box-shadow: 0 8px 18px rgba(0,0,0,.4), 0 0 14px color-mix(in srgb, var(--c) 45%, transparent); }
			.cd img { width: 70px; height: 70px; image-rendering: pixelated; }
			.cd span { font-size: 10px; font-weight: 800; color: #E2E6EE; max-width: 92%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.cd em { position: absolute; top: 5px; right: 5px; display: flex; gap: 2px; }
			.cd.no-j { box-shadow: 0 0 0 2px #3D8CFF; } .cd.no-o { box-shadow: 0 0 0 2px #FF5A36; }
			.cd-mais { grid-column: 1 / -1; text-align: center; font-size: 11px; color: #737C8C; padding: 10px; }
			.sel-rodape { position: absolute; left: 16px; right: 16px; bottom: 14px; height: 60px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
			#ar-previa { flex: 1 1 auto; }
			.pv { display: flex; align-items: center; gap: 12px; }
			.pv-tit { font-size: 10px; font-weight: 900; letter-spacing: .2em; color: #8A93A3; }
			.pv-tx { font-size: 11px; fo"
			& "nt-weight: 700; color: #C9CFDA; }
			.pv-dica { font-size: 11px; color: #737C8C; }
			.pv-barra { flex: 0 0 420px; display: flex; height: 22px; border-radius: 999px; overflow: hidden; font-size: 10px; font-weight: 900; }
			.pv-j { background: linear-gradient(90deg, #2563EB, #3D8CFF); color: #fff; display: flex; align-items: center; padding-left: 10px; white-space: nowrap; transition: width .5s; }
			.pv-o { flex: 1; background: linear-gradient(90deg, #FF5A36, #E5383B); color: #fff; display: flex; align-items: center; justify-content: flex-end; padding-right: 10px; white-space: nowrap; }
			
			/* ================= BATALHA ================= */
			.campo { position: absolute; inset: 0; background: radial-gradient(circle at var(--x, 50%) 45%, color-mix(in srgb, var(--c) 75%, #fff 0%), color-mix(in srgb, var(--c) 55%, #05070B) 75%); }
			.campo-j { clip-path: polygon(0 0, 47% 0, 53% 100%, 0 100%); --x: 30%; }
			.campo-o { clip-path: polygon(47% 0, 100% 0, 100% 100%, 53% 100%); --x: 70%; }
			.campo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.35), rgba(0,0,0,.05) 35%, rgba(0,0,0,.55)); }
			.campo-luz { position: absolute; inset: 0; background: repeating-linear-gradient(60deg, rgba(255,255,255,.035) 0 1px, transparent 1px 70px); pointer-events: none; }
			.diag { position: absolute; left: 50%; top: -20px; width: 4px; height: 760px; margin-left: -2px; background: linear-gradient(180deg, transparent, #fff, transparent); transform: rotate(-4.8deg); box-shadow: 0 0 22px 4px rgba(255,255,255,.55); opacity: .75; }
			.vs { position: absolute; left: 640px; top: 300px; width: 74px; height: 74px; margin: -37px 0 0 -37px; border-radius: 50%; background: linear-gradient(#E3350D 0 46%, #15171C 46% 54%, #F2F2F2 54%); border: 3px solid #15171C; box-shadow: 0 0 30px rgba(255,255,255,.45); display: flex; align-items: center; justify-content: center; animation: gira-vs 6s ease-in-out infinite; z-index: 2; }
			.vs span { width: 34px; height: 34px; border-radius: 50%; background: #F2F2F2; border: 3px solid #15171C; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 900; color: #15171C; }
			@keyframes gira-vs { 0%, 80%, 100% { transform: rotate(0); } 85% { transform: rotate(-16deg); } 90% { transform: rotate(14deg); } 95% { transform: rotate(-6deg); } }
			.plat { position: absolute; border-radius: 50%; background: radial-gradient(ellipse, color-mix(in srgb, var(--c) 60%, #fff), color-mix(in srgb, var(--c) 30%, transparent) 50%, transparent 70%); opacity: .7; }
			.plat-o { left: 720px; top: 296px; width: 220px; height: 50px; }
			.plat-j { left: 340px; top: 470px; width: 270px; height: 62px; }
			.mon { position: absolute; display: flex; align-items: flex-end; justify-content: center; z-index: 3; }
			.mon-o { left: 730px; top: 130px; width: 200px; height: 190px; }
			.mon-j { left: 355px; top: 270px; width: 240px; height: 230px; }
			.spr { transform-origin: bottom center; max-width: 110px; filter: drop-shadow(0 12px 10px rgba(0,0,0,.45)); max-height: 100px; }
			.mon-o .spr { transform: scale(1.9); }
			.mon-j .spr { transform: scale(2.3); }
			.entra { animation: entra .7s cubic-bezier(.2,1.4,.4,1) both; }
			.sai { animation: sai .45s ease-in forwards; }
			.dano { animation: dano .5s ease-in-out; }
			.desmaio { animation: desmaia .9s ease-in forwards; }
			.carrega { animation: carrega .5s ease-in-out; }
			.investe-j { animation: inv-j .23s ease-in-out; }
			.investe-o { animation: inv-o .23s ease-in-out; }
			@keyframes entra { from { opacity: 0; transform: scale(.2) translateY(20px); filter: brightness(5); } to { opacity: 1; transform: none; filter: none; } }
			@keyframes sai { to { opacity: 0; transform: scale(.2); filter: brightness(5); } }
			@keyframes dano { 0%, 100% { transform: translateX(0); filter: none; } 15% { transform: translateX(-12px); filter: brightness(3) saturate(0); } 35% { transform: translateX(10px); filter: none; } 55% { transform: translateX(-7px); filter: brightness(3) saturate(0); } 75% { transform: translateX(4px); f"
			& "ilter: none; } }
			@keyframes desmaia { 20% { transform: translateY(-10px); } to { transform: translateY(90px); opacity: 0; filter: grayscale(1) brightness(.6); } }
			@keyframes carrega { 50% { transform: scale(1.06); filter: brightness(1.6) drop-shadow(0 0 16px #fff); } }
			@keyframes inv-j { 50% { transform: translate(150px, -80px) scale(1.06); } }
			@keyframes inv-o { 50% { transform: translate(-150px, 80px) scale(1.06); } }
			
			.hud { position: absolute; top: 60px; width: 384px; height: 70px; box-sizing: border-box; display: flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 16px; background: rgba(8,10,15,.80); border: 1px solid rgba(255,255,255,.14); box-shadow: 0 12px 30px rgba(0,0,0,.45); z-index: 6; }
			.hud-j { left: 254px; } .hud-o { right: 254px; flex-direction: row-reverse; text-align: right; }
			.hud-foto { width: 52px; height: 52px; flex: 0 0 auto; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--c) 70%, #fff), color-mix(in srgb, var(--c) 40%, #000)); border: 2px solid rgba(255,255,255,.7); overflow: hidden; display: flex; align-items: center; justify-content: center; }
			.hud-foto img { width: 58px; height: 58px; object-fit: contain; }
			.hud-corpo { flex: 1 1 auto; }
			.hud-nome { display: flex; align-items: center; gap: 4px; }
			.hud-o .hud-nome { flex-direction: row-reverse; }
			.hud-nome b { font-size: 15px; font-weight: 900; color: #fff; margin: 0 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px; }
			.hud-nome span { font-size: 10px; font-weight: 800; color: #8A93A3; margin: 0 4px; }
			.bolas { margin-left: auto; display: flex; gap: 3px; }
			.hud-o .bolas { margin-left: 0; margin-right: auto; }
			.bolas i { width: 11px; height: 11px; border-radius: 50%; background: linear-gradient(#E3350D 0 46%, #15171C 46% 56%, #F2F2F2 56%); border: 1px solid #15171C; }
			.bolas i.at { box-shadow: 0 0 0 2px #FFCB05; } .bolas i.ko { filter: grayscale(1) brightness(.45); }
			.hp { position: relative; height: 12px; margin-top: 5px; border-radius: 999px; background: rgba(255,255,255,.10); overflow: hidden; box-shadow: inset 0 1px 3px rgba(0,0,0,.5); }
			.hp.mini { height: 6px; margin-top: 3px; }
			.hud-o .hp { transform: scaleX(-1); }
			.hp-fant { position: absolute; left: 0; top: 0; bottom: 0; background: #fff; opacity: .55; transition: width .6s ease-in; }
			.hp-f { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 999px; transition: width .45s ease-out; }
			.hp-f.ok { background: linear-gradient(90deg, #22C55E, #86EFAC); }
			.hp-f.med { background: linear-gradient(90deg, #EAB308, #FDE047); }
			.hp-f.baixo { background: linear-gradient(90deg, #DC2626, #F87171); animation: pisca 1s steps(2) infinite; }
			@keyframes pisca { 50% { opacity: .6; } }
			.hp-tx { margin-top: 3px; font-size: 10px; font-weight: 800; color: #C9CFDA; }
			
			.carta { position: absolute; top: 60px; width: 222px; height: 644px; box-sizing: border-box; padding: 12px; border-radius: 20px; background: linear-gradient(170deg, color-mix(in srgb, var(--c) 30%, #1B2130), #0F131B 55%); border: 1px solid color-mix(in srgb, var(--c) 50%, transparent); box-shadow: 0 18px 40px rgba(0,0,0,.45); z-index: 6; display: flex; flex-direction: column; gap: 6px; }
			.carta-j { left: 16px; } .carta-o { right: 16px; }
			.carta-rot { align-self: center; font-size: 10px; font-weight: 900; letter-spacing: .22em; color: #11151D; background: #fff; padding: 4px 16px; border-radius: 999px; }
			.carta-arte { position: relative; height: 166px; border-radius: 14px; overflow: hidden; background: radial-gradient(circle, color-mix(in srgb, var(--c) 65%, #fff), color-mix(in srgb, var(--c) 35%, #000) 80%); border: 2px solid rgba(255,255,255,.65); display: flex; align-items: center; justify-content: center; }
			.carta-arte img { width: 156px; height: 156px; object-fit: contain; filter: drop-shadow(0 8px 10px rgba(0,0,0,.45)); position: relative; z-index: 1; }
			.holo { position: absolute; inset: 0; z-index: 2; background: linear-gradient(115deg, transparent 30%"
			& ", rgba(255,255,255,.40) 45%, rgba(255,120,255,.18) 50%, transparent 62%); background-size: 260% 100%; mix-blend-mode: screen; animation: holo 3.4s linear infinite; pointer-events: none; }
			@keyframes holo { from { background-position: 150% 0; } to { background-position: -110% 0; } }
			.carta-nome { text-align: center; font-size: 19px; font-weight: 900; font-style: italic; color: #fff; text-transform: uppercase; letter-spacing: .02em; line-height: 1.1; }
			.carta-tipos { text-align: center; }
			.sts { display: flex; flex-direction: column; gap: 5px; margin-top: 2px; }
			.st { display: grid; grid-template-columns: 54px 1fr 26px; align-items: center; gap: 6px; font-size: 10px; }
			.st span { color: #8A93A3; font-weight: 700; }
			.st div { height: 6px; border-radius: 999px; background: rgba(255,255,255,.08); overflow: hidden; }
			.st i { display: block; height: 100%; border-radius: 999px; }
			.st b { text-align: right; color: #fff; }
			.tm-tit { margin-top: 6px; font-size: 9px; font-weight: 900; letter-spacing: .14em; color: #8A93A3; }
			.tm { display: flex; align-items: center; gap: 6px; padding: 4px 6px; border-radius: 12px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.07); }
			.tm img { width: 40px; height: 40px; image-rendering: pixelated; }
			.tm > div { flex: 1; } .tm b { font-size: 11px; color: #fff; }
			.tm.at { border-color: #FFCB05; background: rgba(255,203,5,.08); }
			.tm.ko { opacity: .35; filter: grayscale(1); }
			.tm.pode { cursor: pointer; } .tm.pode:hover { border-color: #fff; background: rgba(255,255,255,.10); }
			
			.msg { position: absolute; left: 254px; right: 254px; top: 498px; height: 30px; display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 700; color: #fff; text-shadow: 0 2px 8px rgba(0,0,0,.8); z-index: 7; }
			.msg.nova { animation: msg .35s ease-out; }
			@keyframes msg { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
			.painel { position: absolute; left: 254px; right: 254px; bottom: 16px; height: 168px; box-sizing: border-box; padding: 10px; border-radius: 18px; background: rgba(8,10,15,.86); border: 1px solid rgba(255,255,255,.12); box-shadow: 0 12px 30px rgba(0,0,0,.45); display: grid; grid-template-columns: 1fr 200px; grid-template-rows: 1fr auto; gap: 8px; z-index: 6; }
			.gps { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
			.gp { position: relative; display: flex; align-items: center; gap: 8px; padding: 0 10px 0 6px; border-radius: 14px; cursor: pointer; background: linear-gradient(100deg, color-mix(in srgb, var(--c) 85%, #000) 0%, color-mix(in srgb, var(--c) 35%, #10141C) 55%, #10141C); border: 1px solid color-mix(in srgb, var(--c) 60%, transparent); transition: transform .12s, filter .12s, box-shadow .12s; overflow: hidden; }
			.gp:hover { transform: translateY(-2px); filter: brightness(1.15); box-shadow: 0 0 18px color-mix(in srgb, var(--c) 60%, transparent); }
			.gp.off { opacity: .45; pointer-events: none; }
			.gp-ico { flex: 0 0 auto; display: flex; filter: drop-shadow(0 2px 4px rgba(0,0,0,.4)); }
			.gp-tx { flex: 1 1 auto; min-width: 0; }
			.gp-tx b { display: block; font-size: 13px; color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,.5); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.gp-tx span { font-size: 9px; color: rgba(255,255,255,.75); }
			.ef { flex: 0 0 auto; font-style: normal; font-size: 8.5px; font-weight: 900; padding: 2px 7px; border-radius: 999px; background: rgba(0,0,0,.45); }
			.ef-sup { color: #86EFAC; box-shadow: 0 0 0 1px #86EFAC; } .ef-pou { color: #FDBA74; } .ef-nul { color: #8A93A3; } .ef-nor { color: #C9CFDA; }
			.acoes { grid-column: 1 / 2; display: flex; align-items: center; gap: 6px; }
			.acoes .bt { height: 26px; font-size: 10.5px; padding: 0 12px; }
			.sim { flex: 1 1 auto; min-width: 0; }
			.sim .pv-barra { height: 16px; font-size: 9px; }
			.sim-tx { font-size: 9px; color: #8A93A3; margin-top: 2px; }
			.logbox { grid-column: 2; grid-row: 1 / 3; display: flex; flex-direction: column; border-left: 1px s"
			& "olid rgba(255,255,255,.08); padding-left: 10px; min-height: 0; }
			.log-tit { font-size: 9px; font-weight: 900; letter-spacing: .18em; color: #8A93A3; margin-bottom: 4px; }
			.log { flex: 1 1 auto; min-height: 0; overflow-y: auto; font-size: 10.5px; line-height: 1.55; color: #C9CFDA; }
			.log b { color: #fff; } .log i { font-style: normal; } .log .sup { color: #86EFAC; } .log .pou { color: #FDBA74; } .log .crit { color: #FFCB05; }
			
			/* ================= EFEITOS ================= */
			.efx { position: absolute; inset: 0; pointer-events: none; z-index: 20; }
			.treme { animation: treme .35s; } .treme-forte { animation: treme-forte .6s; }
			@keyframes treme { 25% { transform: translate(-5px, 3px); } 50% { transform: translate(5px, -3px); } 75% { transform: translate(-3px, 2px); } }
			@keyframes treme-forte { 10%, 50%, 90% { transform: translate(-10px, 5px); } 30%, 70% { transform: translate(10px, -5px); } }
			.pt { position: absolute; display: block; animation-fill-mode: forwards; animation-timing-function: ease-out; }
			.p-chama, .p-bolha, .p-folha, .p-cristal, .p-orbe, .p-sombra, .p-estrela, .p-gota, .p-nuvem { margin: -9px 0 0 -9px; width: 18px; height: 18px; animation-name: voa; }
			.p-chama { border-radius: 50% 50% 50% 0; background: radial-gradient(circle at 40% 40%, #FFF3B0, #FFB347 40%, var(--c) 75%); box-shadow: 0 0 14px 4px color-mix(in srgb, var(--c) 70%, transparent); }
			.p-bolha, .p-gota { border-radius: 50%; border: 2px solid rgba(255,255,255,.85); background: radial-gradient(circle at 30% 30%, #fff 0 15%, color-mix(in srgb, var(--c) 60%, transparent) 60%); }
			.p-gota { border-radius: 50% 0 50% 50%; }
			.p-folha { width: 14px; height: 22px; border-radius: 0 100% 0 100%; background: linear-gradient(135deg, #C8F7A8, var(--c)); }
			.p-cristal { background: linear-gradient(135deg, #fff, var(--c)); clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%); }
			.p-orbe { border-radius: 50%; background: radial-gradient(circle, #fff 0 20%, var(--c) 60%, transparent 72%); box-shadow: 0 0 16px 4px var(--c); }
			.p-sombra { width: 26px; height: 26px; border-radius: 50%; background: radial-gradient(circle, #1B1030 0 30%, var(--c) 60%, transparent 72%); filter: blur(1px); }
			.p-estrela { background: #FFF1F8; clip-path: polygon(50% 0, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0 50%, 39% 39%); filter: drop-shadow(0 0 6px var(--c)); }
			.p-nuvem { width: 30px; height: 30px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--c) 80%, #fff), transparent 70%); }
			@keyframes voa { 0% { transform: translate(0,0) scale(.6) rotate(0); opacity: 1; } 80% { opacity: 1; } 100% { transform: translate(var(--dx), var(--dy)) scale(1.2) rotate(240deg); opacity: 0; } }
			.anel { margin: -20px 0 0 -20px; width: 40px; height: 40px; border-radius: 50%; border: 5px solid var(--c); box-shadow: 0 0 20px var(--c); animation-name: anel; }
			.anel.grande { border-width: 3px; }
			@keyframes anel { to { transform: scale(4.5); opacity: 0; border-width: 1px; } }
			.flash { left: 0 !important; top: 0 !important; width: 1280px; height: 720px; background: var(--c); animation-name: flash; }
			@keyframes flash { 0% { opacity: .55; } 100% { opacity: 0; } }
			.raio { width: 46px; height: 240px; margin-left: -23px; filter: drop-shadow(0 0 12px #FFF6A0) drop-shadow(0 0 24px var(--c)); animation-name: raio; animation-timing-function: steps(1, end); }
			.raio::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, #fff, #FFF6A0 60%, var(--c)); clip-path: polygon(55% 0, 20% 48%, 48% 48%, 25% 100%, 82% 38%, 55% 38%, 78% 0); }
			@keyframes raio { 0% { opacity: 1; } 30% { opacity: .2; } 45% { opacity: 1; } 100% { opacity: 0; } }
			.poeira { margin: -8px 0 0 -8px; width: 16px; height: 16px; border-radius: 50%; background: color-mix(in srgb, var(--c) 70%, #fff); filter: blur(2px); animation-name: voa; }
			.pedra { margin: -12px 0 0 -12px; width: 24px; height: 24px; background: linear-gradient(135deg, #E2D6A8, var(--c) 60%, #5C4A1C); clip-path: polygon(20% 0, 80% 10%, 100"
			& "% 60%, 60% 100%, 0 70%); animation-name: cai; animation-timing-function: cubic-bezier(.55,0,1,.45); }
			@keyframes cai { 0% { transform: translate(0,0) rotate(0); opacity: 1; } 100% { transform: translate(var(--dx), var(--dy)) rotate(300deg); opacity: 1; } }
			.corte { width: 180px; height: 6px; border-radius: 6px; background: linear-gradient(90deg, transparent, #fff 30%, var(--c) 70%, transparent); box-shadow: 0 0 14px var(--c); animation-name: corte; }
			@keyframes corte { 0% { scale: 0 1; opacity: 1; } 50% { scale: 1 1; opacity: 1; } 100% { scale: 1 .2; opacity: 0; } }
			.vento { margin-top: -20px; width: 120px; height: 40px; border-radius: 50%; border-top: 4px solid color-mix(in srgb, var(--c) 60%, #fff); animation-name: voa; }
			.estrelao { margin: -60px 0 0 -60px; width: 120px; height: 120px; background: radial-gradient(circle, #fff 0 25%, color-mix(in srgb, var(--c) 70%, #fff) 50%, transparent 72%); clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); animation-name: estrelao; }
			@keyframes estrelao { 0% { transform: scale(.2) rotate(0); opacity: 1; } 60% { transform: scale(1.1) rotate(25deg); opacity: 1; } 100% { transform: scale(1.4) rotate(35deg); opacity: 0; } }
			.feixe { height: 22px; margin-top: -11px; transform-origin: 0 50%; border-radius: 22px; background: linear-gradient(90deg, #fff, var(--c) 40%, color-mix(in srgb, var(--c) 50%, #fff)); box-shadow: 0 0 24px 6px var(--c); animation-name: feixe; }
			@keyframes feixe { 0% { scale: 0 1; opacity: 1; } 40% { scale: 1 1; opacity: 1; } 100% { scale: 1 .1; opacity: 0; } }
			.tx { position: absolute; transform: translateX(-50%); font-weight: 900; white-space: nowrap; animation: sobe 1.4s ease-out forwards; }
			.tx.num { font-size: 40px; color: #fff; -webkit-text-stroke: 2px #11151D; text-shadow: 0 4px 0 #11151D; }
			.tx.num.sup { color: #86EFAC; }
			.tx.crit { font-size: 20px; color: #FFCB05; -webkit-text-stroke: 1px #11151D; margin-top: -40px; }
			.tx.erro { font-size: 24px; color: #C9CFDA; -webkit-text-stroke: 1px #11151D; }
			@keyframes sobe { 0% { opacity: 0; transform: translate(-50%, 14px) scale(.5); } 15% { opacity: 1; transform: translate(-50%, 0) scale(1.2); } 100% { opacity: 0; transform: translate(-50%, -70px) scale(1); } }
			.banner { position: absolute; left: 640px; top: 330px; transform: translate(-50%, -50%); font-size: 64px; font-weight: 900; font-style: italic; white-space: nowrap; animation: banner 1.4s ease-out forwards; }
			.banner.sup { color: #86EFAC; -webkit-text-stroke: 3px #052E16; text-shadow: 0 0 30px rgba(34,197,94,.9), 0 6px 0 #052E16; }
			.banner.pou { font-size: 38px; color: #FDBA74; -webkit-text-stroke: 2px #431407; }
			.banner.nul { font-size: 40px; color: #C9CFDA; -webkit-text-stroke: 2px #11151D; }
			@keyframes banner { 0% { opacity: 0; transform: translate(-50%, -50%) scale(.3) rotate(-8deg); } 15% { opacity: 1; transform: translate(-50%, -50%) scale(1.15) rotate(-4deg); } 70% { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(-4deg); } 100% { opacity: 0; transform: translate(-50%, -62%) scale(1.05) rotate(-4deg); } }
			.intro { position: absolute; inset: 0; z-index: 40; background: rgba(5,7,10,.75); overflow: hidden; animation: intro-sai .3s ease-in 1.6s forwards; }
			.intro-j, .intro-o { position: absolute; top: 0; bottom: 0; width: 56%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; background: radial-gradient(circle, color-mix(in srgb, var(--c) 70%, #fff), color-mix(in srgb, var(--c) 40%, #000) 70%); }
			.intro-j { left: 0; clip-path: polygon(0 0, 100% 0, 86% 100%, 0 100%); animation: intro-esq .5s cubic-bezier(.2,1.2,.4,1) both; }
			.intro-o { right: 0; clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%); animation: intro-dir .5s cubic-bezier(.2,1.2,.4,1) .15s both; }
			.intro img { width: 300px; height: 300px; object-fit: contain; filter: drop-shadow(0 18px 20px rgba(0,0,0,.5)); }
			.intro b { font-size: 40px; font-weight: 900; font-style: italic; color: #fff; t"
			& "ext-transform: uppercase; -webkit-text-stroke: 2px #11151D; }
			.intro-vs { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-size: 110px; font-weight: 900; font-style: italic; color: #FFCB05; -webkit-text-stroke: 4px #11151D; text-shadow: 0 0 40px rgba(255,203,5,.8); animation: vs-in .5s cubic-bezier(.2,1.6,.4,1) .55s both; }
			@keyframes intro-esq { from { transform: translateX(-100%); } to { transform: none; } }
			@keyframes intro-dir { from { transform: translateX(100%); } to { transform: none; } }
			@keyframes vs-in { from { transform: translate(-50%, -50%) scale(4); opacity: 0; } to { transform: translate(-50%, -50%) scale(1); opacity: 1; } }
			@keyframes intro-sai { to { opacity: 0; } }
			
			/* ================= OVERLAYS ================= */
			.ov { position: absolute; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center; background: rgba(5,7,10,.66); }
			.ov-box { position: relative; z-index: 2; padding: 22px 28px; border-radius: 22px; background: linear-gradient(160deg, #1E2430, #0E1118); border: 1px solid rgba(255,255,255,.14); box-shadow: 0 24px 60px rgba(0,0,0,.6); display: flex; flex-direction: column; align-items: center; gap: 14px; }
			.ov-tit { font-size: 14px; font-weight: 900; letter-spacing: .12em; color: #fff; }
			.tc-cards { display: flex; gap: 12px; }
			.tc-card { width: 170px; padding: 12px; box-sizing: border-box; border-radius: 16px; background: radial-gradient(circle at 50% 30%, color-mix(in srgb, var(--c) 40%, transparent), transparent 70%), rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.14); display: flex; flex-direction: column; align-items: center; gap: 4px; cursor: pointer; transition: transform .12s, border-color .12s; }
			.tc-card:hover { transform: translateY(-4px); border-color: #FFCB05; }
			.tc-card.off { opacity: .3; pointer-events: none; filter: grayscale(1); }
			.tc-card img { width: 100px; height: 100px; object-fit: contain; }
			.tc-card b { font-size: 13px; color: #fff; } .tc-card .hp { width: 100%; } .tc-card span { font-size: 10px; color: #C9CFDA; font-weight: 700; }
			.fim { min-width: 440px; }
			.fim-tit { font-size: 64px; font-weight: 900; font-style: italic; letter-spacing: .04em; -webkit-text-stroke: 2px #11151D; }
			.fim.win .fim-tit { color: #FFCB05; text-shadow: 0 0 36px rgba(255,203,5,.6); }
			.fim.lose .fim-tit { color: #F87171; text-shadow: 0 0 30px rgba(229,56,59,.45); }
			.fim-sub { font-size: 13px; color: #C9CFDA; }
			.fim-bts { display: flex; gap: 10px; }
			.confete { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
			.confete i { position: absolute; top: -20px; width: 9px; height: 14px; border-radius: 2px; animation-name: confete; animation-iteration-count: infinite; animation-timing-function: linear; }
			@keyframes confete { 0% { transform: translateY(0) rotate(0); } 100% { transform: translateY(760px) rotate(720deg); } }
			
			/* ================= MEGA / GIGANTAMAX ================= */
			.bt-mega { color: #fff; border: 1px solid rgba(255,255,255,.35); animation: pulsa 1.6s ease-in-out infinite; }
			.bt-mega.mega { background: linear-gradient(90deg, #7C3AED, #EC4899, #F59E0B); }
			.bt-mega.gmax { background: linear-gradient(90deg, #991B1B, #E11D48, #FB7185); }
			.gmax-t { font-style: normal; font-size: 8.5px; font-weight: 900; letter-spacing: .06em; color: #fff; background: #E11D48; padding: 1px 6px; border-radius: 999px; margin: 0 4px; box-shadow: 0 0 10px rgba(225,29,72,.7); }
			.mon-o.gmax .spr { transform: scale(2.15); }
			.mon-j.gmax .spr { transform: scale(2.55); }
			.gmax .spr { filter: drop-shadow(0 0 16px rgba(255,40,90,.95)) drop-shadow(0 12px 10px rgba(0,0,0,.45)); }
			.gmax::before { content: ''; position: absolute; left: -70px; right: -70px; top: -90px; bottom: -20px; border-radius: 50%; background: radial-gradient(ellipse at 50% 70%, rgba(255,40,90,.55), rgba(120,0,40,.25) 45%, transparent 70%); filter: blur(6px); animation: nuvem-g 2.2s ease-in-out infinite alternate; }
			@keyframes nuvem-g { from { opacity: .6; transform: scale(.9"
			& "5); } to { opacity: 1; transform: scale(1.06); } }
			.mega-anim { animation: mega-anim 1.5s ease-in-out; }
			.gmax-anim { animation: gmax-anim 1.5s ease-in-out; }
			@keyframes mega-anim { 0%, 100% { filter: none; } 10%, 30%, 50%, 70%, 90% { filter: brightness(0) invert(1) drop-shadow(0 0 18px #fff); transform: scale(1.06); } 20%, 40%, 60%, 80% { filter: hue-rotate(180deg) brightness(1.6); transform: scale(.96); } }
			@keyframes gmax-anim { 0% { transform: scale(1); } 70% { transform: scale(1.5); filter: brightness(1.8) drop-shadow(0 0 30px #FF2E63); } 100% { transform: scale(1.7); filter: brightness(3); opacity: .4; } }
			.arco { margin: -100px 0 0 -100px; width: 200px; height: 200px; border-radius: 50%; background: conic-gradient(#ff3b3b, #ffb13b, #fff23b, #4bff6b, #3bd7ff, #5b5bff, #d83bff, #ff3b3b); -webkit-mask-image: radial-gradient(circle, transparent 52%, #000 54%, #000 64%, transparent 66%); animation-name: arco; animation-timing-function: ease-in-out; }
			.arco.gx { background: conic-gradient(#ff2e63, #7a0021, #ff2e63, #ff8fab, #ff2e63); }
			@keyframes arco { 0% { transform: scale(.3) rotate(0); opacity: 0; } 20% { opacity: 1; } 80% { opacity: 1; } 100% { transform: scale(1.7) rotate(600deg); opacity: 0; } }
			.banner.mega { background: linear-gradient(90deg, #FF3B3B, #FFB13B, #FFF23B, #4BFF6B, #3BD7FF, #D83BFF); -webkit-background-clip: text; color: transparent; -webkit-text-stroke: 2px #11151D; filter: drop-shadow(0 0 18px rgba(255,255,255,.6)); }
			.banner.gmax { color: #FF2E63; -webkit-text-stroke: 3px #3B0014; text-shadow: 0 0 34px rgba(255,46,99,.9), 0 6px 0 #3B0014; }
			"
		displayFolder: <HTML>\CSS

	measure 'JS Dados' =
			
			VAR _pk = CONCATENATEX(
			    ALL(Pokemon),
			    "[" & Pokemon[PokemonId] & ",'" & SUBSTITUTE(Pokemon[Nome], "'", "\'") & "'," & Pokemon[SpeciesId]
			  & ",'" & Pokemon[Tipo1Slug] & "','" & Pokemon[Tipo2Slug] & "',"
			  & COALESCE(Pokemon[HP], 1) & "," & COALESCE(Pokemon[Ataque], 1) & "," & COALESCE(Pokemon[Defesa], 1) & ","
			  & COALESCE(Pokemon[AtqEsp], 1) & "," & COALESCE(Pokemon[DefEsp], 1) & "," & COALESCE(Pokemon[Velocidade], 1) & ","
			  & IF(Pokemon[IsDefault], 1, 0) & "," & COALESCE(Pokemon[Geracao], 0) & "," & IF(Pokemon[Lendario] || Pokemon[Mitico], 1, 0) & "]",
			    ",", Pokemon[OrdemDex], ASC
			)
			VAR _ef = CONCATENATEX(
			    FILTER(ALL(Eficacia), Eficacia[Fator] <> 1),
			    "'" & Eficacia[Ataque] & ">" & Eficacia[Defesa] & "':" & FORMAT(Eficacia[Fator], "0.0#", "en-US"),
			    ","
			)
			VAR _gp = CONCATENATEX(
			    ALL(Golpes),
			    "['" & Golpes[Tipo] & "','" & Golpes[Categoria] & "','" & Golpes[Papel] & "','" & SUBSTITUTE(Golpes[Nome], "'", "\'")
			  & "'," & Golpes[Poder] & "," & Golpes[Precisao] & "," & Golpes[Prioridade] & "]",
			    ","
			)
			VAR _tp = CONCATENATEX(ALL(Tipos), Tipos[TipoSlug] & ":['" & Tipos[Tipo] & "','" & Tipos[Cor] & "']", ",", Tipos[Ordem], ASC)
			VAR _versao = COUNTROWS(ALL(Pokemon)) * 1000 + COUNTROWS(ALL(Golpes))
			RETURN
			    "window.ARENA_DADOS={v:" & _versao & ",pk:[" & _pk & "],ef:{" & _ef & "},gp:[" & _gp & "],tp:{" & _tp & "}};"
		formatString: 0
		displayFolder: Base

	measure '<HTML> Matriz Tipos' =
			
			VAR _dados = [JS Dados]
			VAR _motor =
			"/* Base compartilhada das páginas em JavaScript (Arena, Tipos, Quiz).
			   Lê window.ARENA_DADOS (medida DAX [JS Dados]) e publica window.PK com dados e utilidades.
			     pk: [id, nome, especie, tipo1, tipo2, hp, atk, def, spa, spd, spe, padrao, geracao, lendario/mítico]
			     ef: { 'ataque>defesa': fator }   gp: golpes   tp: { slug: [nome PT, cor] }
			   Não use aspas duplas neste arquivo (ele vira uma string DAX). */
			(function () {
			  var D = window.ARENA_DADOS;
			  if (!D) { return; }
			  if (window.PK && window.PK.v === D.v) { return; }
			
			  var SPR = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/';
			  var ICO = 'https://raw.githubusercontent.com/partywhale/pokemon-type-icons/main/icons/';
			  var P = {}, LISTA = [];
			  D.pk.forEach(function (r) {
			    var p = { id: r[0], nome: r[1], esp: r[2], t: r[4] ? [r[3], r[4]] : [r[3]],
			      b: { hp: r[5], atk: r[6], def: r[7], spa: r[8], spd: r[9], spe: r[10] }, padrao: r[11] === 1, gen: r[12] || 0, lend: r[13] === 1 };
			    p.total = p.b.hp + p.b.atk + p.b.def + p.b.spa + p.b.spd + p.b.spe;
			    P[p.id] = p; LISTA.push(p);
			  });
			  var TIPOS = Object.keys(D.tp);
			
			  function ef(a, d) { var x = D.ef[a + '>' + d]; return x === undefined ? 1 : x; }
			  function efTotal(tipo, tiposDef) { return tiposDef.reduce(function (m, d) { return m * ef(tipo, d); }, 1); }
			  function corTipo(t) { return (D.tp[t] || ['', '#888'])[1]; }
			  function nomeTipo(t) { return (D.tp[t] || [t])[0]; }
			  function icone(t, tam) {
			    return `<img class='pk-ico' src='${ICO + t}.svg' title='${nomeTipo(t)}' style='width:${tam || 18}px;height:${tam || 18}px'/>`;
			  }
			  function chip(t) {
			    return `<span class='pk-chip' style='--c:${corTipo(t)}'>${icone(t, 14)}${nomeTipo(t)}</span>`;
			  }
			  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/'/g, '&#39;'); }
			  function fmtEf(x) { return x === 0.5 ? '½' : x === 0.25 ? '¼' : String(x); }
			  function normalizar(s) {
			    return String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]/g, '');
			  }
			  var URL = {
			    sprite: function (id) { return SPR + id + '.png'; },
			    gif: function (id) { return SPR + 'other/showdown/' + id + '.gif'; },
			    costas: function (id) { return SPR + 'other/showdown/back/' + id + '.gif'; },
			    home: function (id) { return SPR + 'other/home/' + id + '.png'; },
			    arte: function (id) { return SPR + 'other/official-artwork/' + id + '.png'; }
			  };
			  /* <img> com cadeia de reserva: se a URL falhar, tenta a próxima */
			  function img(urls, cls, extra) {
			    return `<img class='${cls || ''}' src='${urls[0]}' data-alt='${urls.slice(1).join('|')}' onerror='pkImgErro(this)' ${extra || ''}/>`;
			  }
			  window.pkImgErro = function (el) {
			    var alts = (el.getAttribute('data-alt') || '').split('|').filter(Boolean);
			    if (!alts.length) { el.onerror = null; el.style.visibility = 'hidden'; return; }
			    el.setAttribute('data-alt', alts.slice(1).join('|'));
			    el.src = alts[0];
			  };
			  /* palco fixo de 1280x720 escalado para caber no visual */
			  function escala(raiz) {
			    var palco = raiz.querySelector('.pk-palco');
			    if (!palco) { return; }
			    var w = raiz.clientWidth || window.innerWidth, h = raiz.clientHeight || window.innerHeight;
			    var s = Math.min(w / 1280, h / 720);
			    palco.style.transform = 'translate(' + ((w - 1280 * s) / 2) + 'px,' + ((h - 720 * s) / 2) + 'px) scale(' + s + ')';
			  }
			  function aleatorio(lista) { return lista[Math.floor(Math.random() * lista.length)]; }
			  function embaralhar(lista) {
			    var a = lista.slice();
			    for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var x = a[i]; a[i] = a[j]; a[j] = x; }
			    return a;
			  }
			  /* partículas de fundo por tipo (mesmas classes .fx-<tipo> da Pokédex) */
			  function particulas(tipo, n, semente) {
			    var html = '';
			    for (var i = 1; i <= n; i++) {
			      var k = i + (semente || 0);
			      html += `<i style='left:${(k * 37 + 11) % 100}%;top:${(k * 53 + 7) % 100}%;width:${4 + (k * 7) % 10}"
			& "px;height:${4 + (k * 7) % 10}px;animation-duration:${(5 + ((k * 13) % 60) / 10).toFixed(1)}s;animation-delay:-${(((k * 29) % 80) / 10).toFixed(1)}s'></i>`;
			    }
			    return `<div class='fx fx-${tipo}'>${html}</div>`;
			  }
			
			  window.PK = { v: D.v, D: D, P: P, LISTA: LISTA, TIPOS: TIPOS, ef: ef, efTotal: efTotal, corTipo: corTipo,
			    nomeTipo: nomeTipo, icone: icone, chip: chip, esc: esc, fmtEf: fmtEf, normalizar: normalizar, URL: URL,
			    img: img, escala: escala, aleatorio: aleatorio, embaralhar: embaralhar, particulas: particulas };
			})();
			
			/* Página Tipos: roda de tipos (setas de vantagem), matriz 18x18 e ranking de combinações.
			   Usa window.PK (comum.js). Não use aspas duplas neste arquivo. */
			(function () {
			  var K = window.PK, raiz = document.getElementById('app-raiz');
			  if (!K || !raiz) { return; }
			  var T = K.TIPOS, icone = K.icone, nomeTipo = K.nomeTipo, corTipo = K.corTipo;
			  var S = window.__tipos || (window.__tipos = { aba: 'roda', modo: 'ataque', atk: 'fire', def: ['grass'], foco: null });
			  function $(id) { return document.getElementById(id); }
			
			  /* ================= RODA ================= */
			  var CX = 316, CY = 300, R = 238;
			  function ponto(t) {
			    var a = -Math.PI / 2 + 2 * Math.PI * T.indexOf(t) / T.length;
			    return { x: CX + R * Math.cos(a), y: CY + R * Math.sin(a) };
			  }
			  function seta(de, para, cls, i) {
			    var a = ponto(de), b = ponto(para);
			    var mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2, cx = CX + (mx - CX) * 0.35, cy = CY + (my - CY) * 0.35;
			    var dx = b.x - cx, dy = b.y - cy, d = Math.hypot(dx, dy) || 1, bx = b.x - dx / d * 28, by = b.y - dy / d * 28;
			    var ax = a.x + (cx - a.x) / Math.hypot(cx - a.x, cy - a.y) * 26, ay = a.y + (cy - a.y) / Math.hypot(cx - a.x, cy - a.y) * 26;
			    return `<path class='seta ${cls}' pathLength='1' style='animation-delay:${i * 40}ms' marker-end='url(#m-${cls})' d='M${ax.toFixed(1)},${ay.toFixed(1)} Q${cx.toFixed(1)},${cy.toFixed(1)} ${bx.toFixed(1)},${by.toFixed(1)}'/>`;
			  }
			  function setasHtml() {
			    var html = '', i = 0, foco = S.foco;
			    if (S.modo === 'ataque') {
			      var a = foco || S.atk;
			      T.forEach(function (d) {
			        var x = K.ef(a, d);
			        if (x > 1) { html += seta(a, d, 'sup', i++); } else if (x === 0) { html += seta(a, d, 'nul', i++); } else if (x < 1) { html += seta(a, d, 'pou', i++); }
			      });
			    } else {
			      var def = foco ? [foco] : S.def;
			      if (!def.length) { return ''; }
			      T.forEach(function (t) {
			        var x = K.efTotal(t, def);
			        if (x > 1) { html += seta(t, def[0], x >= 4 ? 'sup4' : 'sup', i++); } else if (x === 0) { html += seta(t, def[0], 'nul', i++); } else if (x < 1) { html += seta(t, def[0], 'pou', i++); }
			      });
			    }
			    return html;
			  }
			  function centroHtml() {
			    if (S.modo === 'ataque') {
			      var a = S.foco || S.atk;
			      var vence = T.filter(function (d) { return K.ef(a, d) > 1; }).length, fraco = T.filter(function (d) { return K.ef(a, d) > 0 && K.ef(a, d) < 1; }).length;
			      return `<div class='rc-ico'>${icone(a, 64)}</div><b style='color:${corTipo(a)}'>${nomeTipo(a)}</b><span>vence <em class='v'>${vence}</em> · fraco em <em class='f'>${fraco}</em></span>`;
			    }
			    var def = S.foco ? [S.foco] : S.def;
			    if (!def.length) { return `<span>Escolha até 2 tipos na roda</span>`; }
			    var ameaca = T.filter(function (t) { return K.efTotal(t, def) > 1; }).length, resiste = T.filter(function (t) { return K.efTotal(t, def) < 1; }).length;
			    return `<div class='rc-ico'>${def.map(function (d) { return icone(d, def.length > 1 ? 48 : 64); }).join('')}</div><b>${def.map(nomeTipo).join(' / ')}</b>
			      <span>ameaças <em class='f'>${ameaca}</em> · resiste a <em class='v'>${resiste}</em></span>`;
			  }
			  function rodaHtml() {
			    var nos = T.map(function (t) {
			      var p = ponto(t), on = S.modo === 'ataque' ? t === S.atk : S.def.indexOf(t) >= 0;
			      return `<div class='no${on ? ' on' : ''}' data-acao='no' data-t='${t}' style='left:${p.x - 25}px;top:${p.y - 25}px;--c:${corTipo(t)}'>${icone(t"
			& ", 44)}<span>${nomeTipo(t)}</span></div>`;
			    }).join('');
			    var marcas = [['sup', '#22C55E'], ['sup4', '#86EFAC'], ['pou', '#EF4444'], ['nul', '#94A3B8']].map(function (m) {
			      return `<marker id='m-${m[0]}' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='6' markerHeight='6' orient='auto-start-reverse'><path d='M0,0 L10,5 L0,10 z' fill='${m[1]}'/></marker>`;
			    }).join('');
			    return `<div class='roda-modos modos'><span class='${S.modo === 'ataque' ? 'on' : ''}' data-acao='modoRoda' data-m='ataque'>⚔ Ataque</span>
			        <span class='${S.modo === 'defesa' ? 'on' : ''}' data-acao='modoRoda' data-m='defesa'>🛡 Defesa</span></div>
			      <div class='roda-leg'>${S.modo === 'ataque'
			        ? `<span><i class='l-sup'></i>dano dobrado</span><span><i class='l-pou'></i>metade</span><span><i class='l-nul'></i>sem efeito</span>`
			        : `<span><i class='l-sup'></i>ameaça (×2)</span><span><i class='l-sup4'></i>ameaça (×4)</span><span><i class='l-pou'></i>resistido</span><span><i class='l-nul'></i>imune</span>`}</div>
			      <div class='roda'>
			        <svg class='roda-svg' width='632' height='600'><defs>${marcas}</defs><circle cx='${CX}' cy='${CY}' r='${R}' class='roda-aro'/><g id='tp-setas'>${setasHtml()}</g></svg>
			        <div class='roda-centro' id='tp-centro'>${centroHtml()}</div>${nos}</div>`;
			  }
			
			  /* ================= MATRIZ ================= */
			  function matrizHtml() {
			    var html = `<div class='canto'><span>DEFENSOR →</span><span>ATACANTE ↓</span></div>`;
			    T.forEach(function (d) { html += `<div class='cab cab-d${S.def.indexOf(d) >= 0 ? ' on' : ''}' data-acao='def' data-t='${d}'>${icone(d, 24)}</div>`; });
			    T.forEach(function (a) {
			      html += `<div class='cab cab-a${a === S.atk ? ' on' : ''}' data-acao='atk' data-t='${a}'>${icone(a, 24)}</div>`;
			      T.forEach(function (d) {
			        var x = K.ef(a, d), cls = x > 1 ? 'c2' : x === 0 ? 'c0' : x < 1 ? 'cm' : 'c1';
			        html += `<div class='cel ${cls}${a === S.atk ? ' ra' : ''}${S.def.indexOf(d) >= 0 ? ' cd' : ''}' data-a='${a}' data-d='${d}'>${x > 1 ? '2' : x === 0 ? '0' : x < 1 ? '½' : ''}</div>`;
			      });
			    });
			    return `<div class='matriz' id='tp-matriz'>${html}</div>`;
			  }
			
			  /* ================= RANKING ================= */
			  var COMBOS = null;
			  function combos() {
			    if (COMBOS) { return COMBOS; }
			    COMBOS = [];
			    for (var i = 0; i < T.length; i++) {
			      for (var j = i; j < T.length; j++) {
			        var def = i === j ? [T[i]] : [T[i], T[j]];
			        var xs = T.map(function (t) { return K.efTotal(t, def); });
			        var fr = xs.filter(function (x) { return x > 1; }).length, x4 = xs.filter(function (x) { return x >= 4; }).length;
			        var re = xs.filter(function (x) { return x > 0 && x < 1; }).length, im = xs.filter(function (x) { return x === 0; }).length;
			        var alvo = def.slice().sort().join('|');
			        var ex = K.LISTA.find(function (p) { return p.padrao && p.t.slice().sort().join('|') === alvo; });
			        COMBOS.push({ def: def, fr: fr, x4: x4, re: re, im: im, nota: re + im * 1.5 - fr - x4, ex: ex });
			      }
			    }
			    COMBOS.sort(function (a, b) { return b.nota - a.nota || a.fr - b.fr; });
			    return COMBOS;
			  }
			  function linhaCombo(c, i) {
			    return `<div class='rk' data-acao='combo' data-d='${c.def.join(',')}'>
			      <span class='rk-pos'>${i}</span><span class='rk-ico'>${c.def.map(function (d) { return icone(d, 26); }).join('')}</span>
			      <span class='rk-nome'>${c.def.map(nomeTipo).join(' / ')}</span>
			      <span class='rk-n f'>${c.fr}${c.x4 ? ` <small>(${c.x4}×4)</small>` : ''}</span><span class='rk-n v'>${c.re}</span><span class='rk-n i'>${c.im}</span>
			      <span class='rk-ex'>${c.ex ? `<img src='${K.URL.sprite(c.ex.id)}' title='${K.esc(c.ex.nome)}'/>` : `<em>sem Pokémon</em>`}</span></div>`;
			  }
			  function rankingHtml() {
			    var cs = combos(), cab = `<div class='rk rk-cab'><span></span><span></span><span>COMBINAÇÃO</span><span>FRAQUEZAS</span><span>RESIST.</span><span>IMUNE</span><span>EXEMPLO</span></div>`;
			    v"
			& "ar melhores = cs.slice(0, 8).map(function (c, i) { return linhaCombo(c, i + 1); }).join('');
			    var piores = cs.slice(-4).reverse().map(function (c, i) { return linhaCombo(c, cs.length - i); }).join('');
			    var ofe = T.map(function (a) { return { t: a, n: T.filter(function (d) { return K.ef(a, d) > 1; }).length }; }).sort(function (a, b) { return b.n - a.n; });
			    var barras = ofe.map(function (o) { return `<div class='of' title='${nomeTipo(o.t)}: dano dobrado em ${o.n} tipos'>${icone(o.t, 22)}<div><i style='height:${o.n * 18}px;background:${corTipo(o.t)}'></i></div><b>${o.n}</b></div>`; }).join('');
			    return `<div class='rk-sec'>🛡 MELHORES DEFESAS <em>de 171 combinações · clique para analisar</em></div>${cab}${melhores}
			      <div class='rk-sec'>⚠ MAIS VULNERÁVEIS</div>${piores}
			      <div class='rk-sec'>⚔ COBERTURA OFENSIVA <em>quantos tipos cada um atinge com dano dobrado</em></div><div class='ofs'>${barras}</div>`;
			  }
			
			  /* ================= DETALHE (direita) ================= */
			  function chips(lista, vazio) { return lista.length ? lista.map(K.chip).join('') : `<span class='vazio'>${vazio}</span>`; }
			  function detalheHtml() {
			    var a = S.atk, def = S.def;
			    var x = def.length ? K.efTotal(a, def) : 1;
			    var rot = x >= 4 ? 'EXTREMAMENTE EFETIVO' : x >= 2 ? 'SUPER EFETIVO' : x === 0 ? 'SEM EFEITO' : x < 1 ? 'POUCO EFETIVO' : 'DANO NORMAL';
			    var cls = x >= 2 ? 'sup' : x === 0 ? 'nul' : x < 1 ? 'pou' : 'nor';
			    var conf = `<div class='conf conf-${cls}'>
			      <div class='conf-lado'><em>ATAQUE</em>${icone(a, 40)}<span>${nomeTipo(a)}</span></div>
			      <div class='conf-meio'><b>×${K.fmtEf(x)}</b><span>${rot}</span></div>
			      <div class='conf-lado'><em>DEFESA</em><div>${def.map(function (d) { return icone(d, 40); }).join('')}</div><span>${def.map(nomeTipo).join(' / ') || 'escolha'}</span></div></div>`;
			    var dobro = T.filter(function (d) { return K.ef(a, d) > 1; }), metade = T.filter(function (d) { return K.ef(a, d) > 0 && K.ef(a, d) < 1; }), nada = T.filter(function (d) { return K.ef(a, d) === 0; });
			    var ataque = `<div class='sec'><div class='sec-tit'><span class='bola' style='background:${corTipo(a)}'></span>ATACANDO COM <b style='color:${corTipo(a)}'>${nomeTipo(a).toUpperCase()}</b></div>
			      <div class='lin'><em class='rot-sup'>Dano dobrado em</em><div>${chips(dobro, 'nenhum')}</div></div>
			      <div class='lin'><em class='rot-pou'>Metade do dano em</em><div>${chips(metade, 'nenhum')}</div></div>
			      <div class='lin'><em class='rot-nul'>Não causa dano em</em><div>${chips(nada, 'nenhum')}</div></div></div>`;
			    var defesa = '';
			    if (def.length) {
			      var lista = T.map(function (t) { return { t: t, x: K.efTotal(t, def) }; }).sort(function (p, q) { return q.x - p.x || T.indexOf(p.t) - T.indexOf(q.t); });
			      var barras = lista.map(function (o) {
			        var c = o.x > 1 ? 'b-sup' : o.x === 0 ? 'b-nul' : o.x < 1 ? 'b-pou' : 'b-nor';
			        return `<div class='bar'>${icone(o.t, 16)}<span>${nomeTipo(o.t)}</span><div class='bar-t'><i class='${c}' style='width:${o.x === 0 ? 100 : Math.min(100, 25 * o.x)}%'></i></div><b class='${c}'>×${K.fmtEf(o.x)}</b></div>`;
			      }).join('');
			      defesa = `<div class='sec'><div class='sec-tit'>DEFENDENDO COMO <b>${def.map(function (d) { return `<span style='color:${corTipo(d)}'>${nomeTipo(d).toUpperCase()}</span>`; }).join(' / ')}</b>
			        <em>${lista.filter(function (o) { return o.x > 1; }).length} fraquezas · ${lista.filter(function (o) { return o.x < 1; }).length} resistências</em></div><div class='bars'>${barras}</div></div>`;
			      var alvo = def.slice().sort().join('|');
			      var poks = K.LISTA.filter(function (p) { return p.padrao && p.t.slice().sort().join('|') === alvo; });
			      defesa += `<div class='sec'><div class='sec-tit'>POKÉMON COM ESSA DEFESA <em>${poks.length} encontrados</em></div>
			        <div class='pks'>${poks.slice(0, 11).map(function (p) { return `<div class='pk' title='${K.esc(p.nome)}'><img loading='lazy' src='${K.URL.sprite(p"
			& ".id)}'/><span>${K.esc(p.nome)}</span></div>`; }).join('') || `<span class='vazio'>Nenhum Pokémon tem exatamente essa combinação.</span>`}${poks.length > 11 ? `<div class='pk mais'>+${poks.length - 11}</div>` : ''}</div></div>`;
			    }
			    return conf + ataque + defesa;
			  }
			
			  /* ================= RENDER ================= */
			  function render() {
			    var abas = [['roda', '◎ Roda'], ['matriz', '▦ Matriz'], ['ranking', '🏆 Ranking']].map(function (a) {
			      return `<span class='${S.aba === a[0] ? 'on' : ''}' data-acao='aba' data-a='${a[0]}'>${a[1]}</span>`;
			    }).join('');
			    var corpo = S.aba === 'roda' ? rodaHtml() : S.aba === 'matriz' ? matrizHtml() : rankingHtml();
			    raiz.innerHTML = `<div class='pk-palco tipos'>
			      <div class='topo'><div class='modos abas'>${abas}</div><div class='titulo'><b>TIPOS</b><span>quem vence quem</span></div></div>
			      <div class='painel-m vidro aba-${S.aba}'>${corpo}</div>
			      <div class='painel-d vidro' id='tp-det'>${detalheHtml()}</div></div>`;
			    K.escala(raiz);
			    var m = $('tp-matriz');
			    if (m) {
			      m.onmouseover = function (ev) {
			        var c = ev.target.closest('.cel'); if (!c) { return; }
			        m.querySelectorAll('.hl').forEach(function (x) { x.classList.remove('hl'); });
			        m.querySelectorAll(`.cel[data-a='${c.getAttribute('data-a')}'], .cel[data-d='${c.getAttribute('data-d')}']`).forEach(function (x) { x.classList.add('hl'); });
			      };
			      m.onmouseleave = function () { m.querySelectorAll('.hl').forEach(function (x) { x.classList.remove('hl'); }); };
			    }
			    var roda = raiz.querySelector('.roda');
			    if (roda) {
			      roda.onmouseover = function (ev) {
			        var no = ev.target.closest('.no'); var t = no ? no.getAttribute('data-t') : null;
			        if (t === S.foco) { return; }
			        S.foco = t; $('tp-setas').innerHTML = setasHtml(); $('tp-centro').innerHTML = centroHtml();
			      };
			      roda.onmouseleave = function () { S.foco = null; $('tp-setas').innerHTML = setasHtml(); $('tp-centro').innerHTML = centroHtml(); };
			    }
			  }
			  function alternarDef(t) {
			    var i = S.def.indexOf(t);
			    if (i >= 0) { S.def.splice(i, 1); } else { S.def.push(t); if (S.def.length > 2) { S.def.shift(); } }
			  }
			  raiz.onclick = function (ev) {
			    var cel = ev.target.closest('.cel');
			    if (cel) { S.atk = cel.getAttribute('data-a'); S.def = [cel.getAttribute('data-d')]; render(); return; }
			    var el = ev.target.closest('[data-acao]'); if (!el) { return; }
			    var t = el.getAttribute('data-t');
			    switch (el.getAttribute('data-acao')) {
			      case 'aba': S.aba = el.getAttribute('data-a'); S.foco = null; break;
			      case 'modoRoda': S.modo = el.getAttribute('data-m'); S.foco = null; break;
			      case 'no': if (S.modo === 'ataque') { S.atk = t; } else { alternarDef(t); } S.foco = null; break;
			      case 'atk': S.atk = t; break;
			      case 'def': alternarDef(t); break;
			      case 'combo': S.def = el.getAttribute('data-d').split(','); S.modo = 'defesa'; break;
			    }
			    render();
			  };
			  if (!window.__tiposResize) { window.__tiposResize = true; window.addEventListener('resize', function () { K.escala(raiz); }); }
			  render();
			})();
			"
			RETURN
			    "<div id='app-raiz'></div><script>" & _dados & "</script><script>" & _motor & "</script>"
		displayFolder: <HTML>

	measure '<CSS> Matriz Tipos' =
			
			"#htmlContent { margin: 0; padding: 0; height: 100vh; overflow: hidden; font-family: 'Segoe UI', sans-serif; color: #E9ECF2; background: #0B0E14; }
			.htmlViewerEntry { height: 100vh; }
			#app-raiz { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #0B0E14; }
			.pk-palco { position: absolute; left: 0; top: 0; width: 1280px; height: 720px; transform-origin: 0 0; overflow: hidden; background: radial-gradient(circle at 50% 30%, #1A2130, #0B0E14 70%); }
			.pk-ico { display: inline-block; vertical-align: middle; border-radius: 50%; }
			.pk-chip { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 800; color: #fff; padding: 2px 9px 2px 3px; border-radius: 999px; background: var(--c); margin: 0 4px 3px 0; text-shadow: 0 1px 1px rgba(0,0,0,.35); }
			.bt { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 34px; padding: 0 18px; border-radius: 999px; font-size: 12px; font-weight: 800; letter-spacing: .05em; cursor: pointer; user-select: none; transition: transform .12s, filter .12s, box-shadow .12s; white-space: nowrap; }
			.bt:hover { transform: translateY(-1px); filter: brightness(1.12); }
			.bt.off { opacity: .35; pointer-events: none; }
			.bt-sec { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); color: #E9ECF2; }
			.bt-sec.on { background: rgba(255,203,5,.16); border-color: #FFCB05; color: #FFCB05; }
			.bt-gold { background: #FFCB05; color: #11151D; box-shadow: 0 0 18px rgba(255,203,5,.35); }
			.bt-go { height: 48px; padding: 0 44px; font-size: 17px; letter-spacing: .14em; background: linear-gradient(90deg, #FF5A36, #FFCB05); color: #11151D; box-shadow: 0 0 28px rgba(255,140,40,.5); animation: pulsa 2s ease-in-out infinite; }
			.bt-go.off { animation: none; }
			@keyframes pulsa { 0%, 100% { box-shadow: 0 0 20px rgba(255,140,40,.4); } 50% { box-shadow: 0 0 38px rgba(255,160,40,.75); } }
			.topo { position: absolute; left: 380px; right: 24px; top: 10px; height: 40px; display: flex; align-items: center; justify-content: space-between; z-index: 5; }
			.titulo { text-align: right; }
			.titulo b { display: block; font-size: 22px; font-weight: 900; letter-spacing: .26em; color: #fff; line-height: 1.1; }
			.titulo span { font-size: 10px; color: #8A93A3; font-weight: 600; letter-spacing: .06em; }
			.vidro { border-radius: 18px; background: linear-gradient(160deg, rgba(30,36,48,.92), rgba(14,17,24,.94)); border: 1px solid rgba(255,255,255,.08); box-shadow: inset 0 1px 0 rgba(255,255,255,.06), 0 18px 40px rgba(0,0,0,.35); }
			::-webkit-scrollbar { width: 6px; height: 6px; } ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.2); border-radius: 6px; } ::-webkit-scrollbar-track { background: transparent; }
			
			/* partículas de fundo por tipo (iguais às da Pokédex) */
			.fx { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
			.fx i { position: absolute; display: block; opacity: 0; animation-iteration-count: infinite; animation-timing-function: linear; }
			.fx-water i, .fx-poison i, .fx-normal i { top: auto !important; bottom: -30px; border-radius: 50%; animation-name: bolha; animation-timing-function: ease-in-out; }
			.fx-water i { border: 1.5px solid rgba(190,215,255,.60); background: radial-gradient(circle at 32% 30%, rgba(255,255,255,.70) 0 12%, rgba(120,160,255,.12) 40%, rgba(104,144,240,.05) 70%); }
			.fx-poison i { border: 1.5px solid rgba(220,150,230,.55); background: radial-gradient(circle at 32% 30%, rgba(255,255,255,.55) 0 12%, rgba(160,64,160,.30) 45%, rgba(160,64,160,.08) 70%); }
			.fx-normal i { background: rgba(255,255,255,.22); }
			@keyframes bolha { 0% { transform: translate(0,0) scale(.7); opacity: 0; } 10% { opacity: .9; } 50% { transform: translate(18px,-380px) scale(1.2); } 90% { opacity: .8; } 100% { transform: translate(-10px,-780px) scale(1.5); opacity: 0; } }
			.fx-fire i { top: auto !important; bottom: -10px; width: 4px !important; height: 4px !important; border-radius: 50%; background: #FFD27A; box-shadow: 0 0 6px 2px rgba(255,"
			& "140,40,.85), 0 0 14px 4px rgba(255,80,20,.35); animation-name: brasa; animation-timing-function: ease-out; }
			@keyframes brasa { 0% { transform: translate(0,0) scale(1); opacity: 0; } 8% { opacity: 1; } 30% { transform: translate(-14px,-200px) scale(.9); } 60% { transform: translate(16px,-420px) scale(.7); opacity: .9; } 100% { transform: translate(-6px,-680px) scale(.2); opacity: 0; } }
			.fx-electric i { width: 18px !important; height: 50px !important; filter: drop-shadow(0 0 6px rgba(248,208,48,.95)); animation-name: raiofx; animation-timing-function: steps(1, end); }
			.fx-electric i::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, #FFFBD0, #F8D030); clip-path: polygon(55% 0, 18% 56%, 45% 56%, 28% 100%, 86% 40%, 58% 40%, 76% 0); }
			@keyframes raiofx { 0%, 100% { opacity: 0; } 3% { opacity: 1; } 5% { opacity: .1; } 7% { opacity: 1; } 10% { opacity: 0; } }
			.fx-grass i, .fx-ice i, .fx-rock i { top: -30px !important; animation-timing-function: ease-in-out; }
			.fx-grass i { width: 10px !important; height: 16px !important; border-radius: 0 100% 0 100%; background: linear-gradient(135deg, #A8E68A, #4E9A2F); animation-name: folhafx; }
			.fx-ice i { border-radius: 50%; background: #fff; box-shadow: 0 0 8px rgba(200,240,255,.9); max-width: 8px; max-height: 8px; animation-name: neve; }
			.fx-rock i { background: #B8A038; clip-path: polygon(20% 0, 80% 10%, 100% 60%, 60% 100%, 0 70%); animation-name: pedrafx; animation-timing-function: cubic-bezier(.5,0,1,1); }
			@keyframes folhafx { 0% { transform: translate(0,0) rotate(0); opacity: 0; } 10% { opacity: .85; } 50% { transform: translate(-60px,380px) rotate(200deg); } 90% { opacity: .7; } 100% { transform: translate(40px,780px) rotate(420deg); opacity: 0; } }
			@keyframes neve { 0% { transform: translate(0,0); opacity: 0; } 10% { opacity: .9; } 50% { transform: translate(30px,380px); } 100% { transform: translate(-20px,780px); opacity: 0; } }
			@keyframes pedrafx { 0% { transform: translate(0,0) rotate(0); opacity: 0; } 5% { opacity: .8; } 100% { transform: translate(20px,780px) rotate(360deg); opacity: .5; } }
			.fx-ghost i { top: auto !important; bottom: -60px; width: 46px !important; height: 46px !important; border-radius: 50%; background: radial-gradient(circle, rgba(170,140,230,.55), rgba(112,88,152,0) 70%); filter: blur(2px); animation-name: alma; animation-timing-function: ease-in-out; }
			@keyframes alma { 0% { transform: translate(0,0) scale(.6); opacity: 0; } 20% { opacity: .85; } 50% { transform: translate(40px,-360px) scale(1.2); } 80% { opacity: .5; } 100% { transform: translate(-30px,-760px) scale(.8); opacity: 0; } }
			.fx-psychic i, .fx-fighting i { width: 30px !important; height: 30px !important; border-radius: 50%; border: 2px solid rgba(248,88,136,.70); animation-name: pulsofx; animation-timing-function: ease-out; }
			.fx-fighting i { border-color: rgba(255,120,60,.70); }
			@keyframes pulsofx { 0% { transform: scale(.2); opacity: 0; } 10% { opacity: .9; } 100% { transform: scale(4); opacity: 0; } }
			.fx-flying i { width: 110px !important; height: 2px !important; border-radius: 2px; background: linear-gradient(90deg, transparent, rgba(225,225,255,.65), transparent); animation-name: ventofx; animation-timing-function: ease-in-out; }
			.fx-ground i { border-radius: 50%; background: rgba(224,192,104,.55); filter: blur(1px); animation-name: poeirafx; }
			.fx-dark i { width: 90px !important; height: 90px !important; border-radius: 50%; background: radial-gradient(circle, rgba(70,50,50,.60), transparent 70%); filter: blur(4px); animation-name: fumaca; animation-timing-function: ease-in-out; }
			@keyframes ventofx { 0% { transform: translateX(-300px); opacity: 0; } 20% { opacity: .8; } 100% { transform: translateX(500px); opacity: 0; } }
			@keyframes poeirafx { 0% { transform: translate(-40px,0); opacity: 0; } 20% { opacity: .7; } 100% { transform: translate(260px,-60px); opacity: 0; } }
			@keyframes fumaca { 0% { transform: translate(0,0) scale(.6); opacity: 0; } 30% { opa"
			& "city: .7; } 100% { transform: translate(120px,-140px) scale(1.6); opacity: 0; } }
			.fx-fairy i, .fx-dragon i, .fx-steel i { width: 12px !important; height: 12px !important; clip-path: polygon(50% 0, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0 50%, 39% 39%); animation-name: brilhofx; animation-timing-function: ease-in-out; }
			.fx-fairy i { background: #FFD6E8; } .fx-dragon i { background: #B9A2FF; } .fx-steel i { background: #EEF3FA; }
			.fx-bug i { width: 5px !important; height: 5px !important; border-radius: 50%; background: #E6F57A; box-shadow: 0 0 10px 3px rgba(200,230,80,.70); animation-name: vagalume; animation-timing-function: ease-in-out; }
			@keyframes brilhofx { 0%, 100% { transform: scale(0) rotate(0); opacity: 0; } 50% { transform: scale(1.4) rotate(90deg); opacity: 1; } }
			@keyframes vagalume { 0% { transform: translate(0,0); opacity: 0; } 25% { transform: translate(30px,-20px); opacity: 1; } 50% { transform: translate(-10px,-50px); opacity: .3; } 75% { transform: translate(-40px,-10px); opacity: 1; } 100% { transform: translate(0,0); opacity: 0; } }
			
			/* controles compartilhados (abas, gerações) */
			.modos { display: flex; gap: 6px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.10); padding: 4px; border-radius: 999px; }
			.modos span { padding: 6px 16px; border-radius: 999px; font-size: 11px; font-weight: 800; color: #C9CFDA; cursor: pointer; white-space: nowrap; transition: background .12s, color .12s; }
			.modos span:hover { color: #fff; background: rgba(255,255,255,.06); }
			.modos span.on { background: #FFCB05; color: #11151D; box-shadow: 0 0 14px rgba(255,203,5,.35); }
			.gens { display: flex; gap: 4px; }
			.gc { flex: 1; text-align: center; font-size: 10px; font-weight: 800; padding: 4px 0; border-radius: 999px; cursor: pointer; color: #C9CFDA; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); }
			.gc:hover { color: #fff; border-color: rgba(255,255,255,.25); }
			.gc.on { background: #FFCB05; color: #11151D; border-color: #FFCB05; }
			.topo { left: 452px; }
			
			.tipos { background: radial-gradient(circle at 30% 20%, #1A2130, #0B0E14 70%); }
			.leg span { display: flex; align-items: center; gap: 5px; }
			.leg i { width: 12px; height: 12px; border-radius: 4px; display: inline-block; }
			.painel-m { position: absolute; left: 16px; top: 60px; width: 648px; height: 644px; box-sizing: border-box; padding: 14px; }
			.pm-tit, .sec-tit { font-size: 11px; font-weight: 900; letter-spacing: .16em; color: #fff; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
			.pm-tit em, .sec-tit em { font-style: normal; font-weight: 600; letter-spacing: 0; color: #737C8C; font-size: 10px; }
			.sec-tit em { margin-left: auto; }
			.matriz { display: grid; grid-template-columns: 56px repeat(18, 1fr); gap: 3px; margin-top: 10px; }
			.canto { display: flex; flex-direction: column; justify-content: space-between; font-size: 7px; font-weight: 900; letter-spacing: .06em; color: #737C8C; height: 28px; }
			.cab { height: 28px; display: flex; align-items: center; justify-content: center; cursor: pointer; border-radius: 50%; transition: transform .12s; }
			.cab:hover { transform: scale(1.18); }
			.cab.on { box-shadow: 0 0 0 2px #fff, 0 0 12px rgba(255,255,255,.6); }
			.cab-a { justify-content: flex-end; padding-right: 6px; border-radius: 8px; }
			.cab-a.on { box-shadow: none; background: rgba(255,255,255,.10); }
			.cel { height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 900; cursor: pointer; transition: transform .1s, filter .1s; }
			.cel:hover { transform: scale(1.2); z-index: 2; filter: brightness(1.2); }
			.c2 { background: #16A34A; color: #fff; } .cm { background: #DC2626; color: #fff; } .c0 { background: #05070A; color: #fff; box-shadow: inset 0 0 0 1px #334; } .c1 { background: rgba(255,255,255,.06); }
			.leg .c1 { background: #2A303C; }
			.cel.hl { filter: brightness(1.25); box-shadow: inset 0 0 0 1px rgba(255,255,255,.45); }
			.cel.c1.hl { background: rgba(255"
			& ",255,255,.16); }
			.cel.ra.cd { box-shadow: 0 0 0 2px #FFCB05, 0 0 14px rgba(255,203,5,.6); z-index: 1; }
			.painel-d { position: absolute; left: 680px; top: 60px; width: 584px; height: 644px; box-sizing: border-box; padding: 14px 16px; display: flex; flex-direction: column; gap: 12px; overflow: hidden; }
			.conf { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; padding: 12px; border-radius: 16px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.10); }
			.conf-lado { display: flex; flex-direction: column; align-items: center; gap: 4px; }
			.conf-lado span { font-size: 11px; font-weight: 800; color: #C9CFDA; }
			.conf-lado img + img { margin-left: -10px; }
			.conf-lado:last-child { flex-direction: column; }
			.conf-meio { text-align: center; }
			.conf-meio b { display: block; font-size: 40px; font-weight: 900; font-style: italic; line-height: 1; }
			.conf-meio span { font-size: 10px; font-weight: 900; letter-spacing: .14em; }
			.conf-sup .conf-meio { color: #4ADE80; text-shadow: 0 0 20px rgba(74,222,128,.5); }
			.conf-pou .conf-meio { color: #F87171; } .conf-nul .conf-meio { color: #8A93A3; } .conf-nor .conf-meio { color: #E9ECF2; }
			.sec { display: flex; flex-direction: column; gap: 7px; }
			.bola { width: 9px; height: 9px; border-radius: 50%; }
			.lin { display: grid; grid-template-columns: 120px 1fr; align-items: start; gap: 6px; }
			.lin em { font-style: normal; font-size: 10px; font-weight: 800; padding-top: 3px; }
			.rot-sup { color: #4ADE80; } .rot-pou { color: #F87171; } .rot-nul { color: #8A93A3; }
			.vazio { font-size: 10px; color: #5C6575; }
			.bars { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 18px; }
			.bar { display: grid; grid-template-columns: 16px 62px 1fr 34px; align-items: center; gap: 6px; font-size: 10px; }
			.bar span { color: #C9CFDA; font-weight: 700; }
			.bar-t { height: 6px; border-radius: 999px; background: rgba(255,255,255,.07); overflow: hidden; }
			.bar-t i { display: block; height: 100%; border-radius: 999px; }
			.bar b { text-align: right; font-size: 10.5px; }
			i.b-sup { background: #EF4444; } i.b-pou { background: #22C55E; } i.b-nul { background: #64748B; } i.b-nor { background: #475569; }
			b.b-sup { color: #F87171; } b.b-pou { color: #4ADE80; } b.b-nul { color: #94A3B8; } b.b-nor { color: #8A93A3; }
			.pks { display: flex; flex-wrap: wrap; gap: 6px; }
			.pk { width: 66px; height: 74px; border-radius: 12px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding-bottom: 4px; box-sizing: border-box; }
			.pk img { width: 52px; height: 52px; image-rendering: pixelated; }
			.pk span { font-size: 8.5px; font-weight: 700; color: #C9CFDA; max-width: 62px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.pk.mais { justify-content: center; font-size: 13px; font-weight: 900; color: #8A93A3; }
			
			/* ================= ABAS / RODA / RANKING ================= */
			.tipos .topo { left: 452px; }
			.abas span { padding: 6px 16px; }
			.painel-m { padding: 12px 14px; }
			.aba-matriz .matriz { margin-top: 0; }
			.roda-modos { position: absolute; left: 16px; top: 14px; z-index: 3; }
			.roda-leg { position: absolute; right: 16px; top: 20px; display: flex; gap: 12px; font-size: 10px; font-weight: 700; color: #C9CFDA; z-index: 3; }
			.roda-leg span { display: flex; align-items: center; gap: 5px; }
			.roda-leg i { width: 16px; height: 3px; border-radius: 3px; display: inline-block; }
			.l-sup { background: #22C55E; } .l-sup4 { background: #86EFAC; height: 5px !important; } .l-pou { background: #EF4444; } .l-nul { background: #94A3B8; }
			.roda { position: absolute; left: 8px; top: 40px; width: 632px; height: 600px; }
			.roda-svg { position: absolute; left: 0; top: 0; }
			.roda-aro { fill: none; stroke: rgba(255,255,255,.07); stroke-width: 2; stroke-dasharray: 4 6; }
			.seta { fill: none; stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: desenha .55s ease-out "
			& "forwards; }
			.seta.sup { stroke: #22C55E; filter: drop-shadow(0 0 4px rgba(34,197,94,.7)); }
			.seta.sup4 { stroke: #86EFAC; stroke-width: 4; filter: drop-shadow(0 0 6px rgba(134,239,172,.9)); }
			.seta.pou { stroke: #EF4444; opacity: .75; }
			.seta.nul { stroke: #94A3B8; stroke-dasharray: .02 .025; stroke-dashoffset: 0; animation: aparece .4s ease-out forwards; opacity: 0; }
			@keyframes desenha { to { stroke-dashoffset: 0; } }
			@keyframes aparece { to { opacity: .9; } }
			.no { position: absolute; width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: transform .15s; z-index: 2; }
			.no img { filter: drop-shadow(0 4px 8px rgba(0,0,0,.5)); }
			.no span { position: absolute; top: 50px; left: 50%; transform: translateX(-50%); font-size: 9.5px; font-weight: 800; color: #C9CFDA; white-space: nowrap; }
			.no:hover { transform: scale(1.18); }
			.no.on { box-shadow: 0 0 0 3px #fff, 0 0 24px var(--c); }
			.no.on span { color: #fff; }
			.roda-centro { position: absolute; left: 216px; top: 200px; width: 200px; height: 200px; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; text-align: center; background: radial-gradient(circle, rgba(30,36,48,.95), rgba(14,17,24,.95)); border: 1px solid rgba(255,255,255,.10); box-shadow: 0 0 40px rgba(0,0,0,.5); z-index: 1; }
			.rc-ico { display: flex; gap: 4px; }
			.roda-centro b { font-size: 18px; font-weight: 900; color: #fff; }
			.roda-centro span { font-size: 10.5px; color: #8A93A3; font-weight: 700; }
			.roda-centro em { font-style: normal; font-weight: 900; }
			.roda-centro em.v { color: #4ADE80; } .roda-centro em.f { color: #F87171; }
			.rk-sec { font-size: 11px; font-weight: 900; letter-spacing: .14em; color: #fff; margin: 4px 0 6px; display: flex; gap: 8px; align-items: baseline; }
			.rk-sec em { font-style: normal; letter-spacing: 0; font-size: 10px; font-weight: 600; color: #737C8C; }
			.rk { display: grid; grid-template-columns: 24px 62px 1fr 78px 56px 50px 50px; align-items: center; gap: 6px; height: 34px; padding: 0 8px; margin-bottom: 3px; border-radius: 10px; background: rgba(255,255,255,.04); cursor: pointer; transition: background .12s; }
			.rk:hover { background: rgba(255,255,255,.10); }
			.rk-cab { height: 18px; background: none; cursor: default; font-size: 8.5px; font-weight: 900; letter-spacing: .12em; color: #5C6575; }
			.rk-cab:hover { background: none; }
			.rk-pos { font-size: 11px; font-weight: 900; color: #8A93A3; }
			.rk-ico { display: flex; } .rk-ico img + img { margin-left: -6px; }
			.rk-nome { font-size: 12px; font-weight: 800; color: #fff; }
			.rk-n { font-size: 13px; font-weight: 900; text-align: center; } .rk-n small { font-size: 9px; }
			.rk-n.f { color: #F87171; } .rk-n.v { color: #4ADE80; } .rk-n.i { color: #CBD5E1; }
			.rk-ex { display: flex; justify-content: center; } .rk-ex img { width: 34px; height: 34px; image-rendering: pixelated; } .rk-ex em { font-size: 8px; color: #5C6575; font-style: normal; }
			.ofs { display: flex; justify-content: space-between; align-items: flex-end; height: 130px; padding: 0 4px; }
			.of { display: flex; flex-direction: column-reverse; align-items: center; gap: 3px; }
			.of div { width: 14px; display: flex; align-items: flex-end; }
			.of i { display: block; width: 14px; border-radius: 4px 4px 0 0; animation: sobe-b .6s ease-out both; transform-origin: bottom; }
			.of b { font-size: 10px; color: #fff; }
			@keyframes sobe-b { from { transform: scaleY(0); } to { transform: scaleY(1); } }
			.conf-lado em { font-style: normal; font-size: 8.5px; font-weight: 900; letter-spacing: .16em; color: #5C6575; }
			.conf-lado > div { display: flex; }
			.conf-lado > div img + img { margin-left: -10px; }
			"
		displayFolder: <HTML>\CSS

	measure '<HTML> Quiz' =
			
			VAR _dados = [JS Dados]
			VAR _motor =
			"/* Base compartilhada das páginas em JavaScript (Arena, Tipos, Quiz).
			   Lê window.ARENA_DADOS (medida DAX [JS Dados]) e publica window.PK com dados e utilidades.
			     pk: [id, nome, especie, tipo1, tipo2, hp, atk, def, spa, spd, spe, padrao, geracao, lendario/mítico]
			     ef: { 'ataque>defesa': fator }   gp: golpes   tp: { slug: [nome PT, cor] }
			   Não use aspas duplas neste arquivo (ele vira uma string DAX). */
			(function () {
			  var D = window.ARENA_DADOS;
			  if (!D) { return; }
			  if (window.PK && window.PK.v === D.v) { return; }
			
			  var SPR = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/';
			  var ICO = 'https://raw.githubusercontent.com/partywhale/pokemon-type-icons/main/icons/';
			  var P = {}, LISTA = [];
			  D.pk.forEach(function (r) {
			    var p = { id: r[0], nome: r[1], esp: r[2], t: r[4] ? [r[3], r[4]] : [r[3]],
			      b: { hp: r[5], atk: r[6], def: r[7], spa: r[8], spd: r[9], spe: r[10] }, padrao: r[11] === 1, gen: r[12] || 0, lend: r[13] === 1 };
			    p.total = p.b.hp + p.b.atk + p.b.def + p.b.spa + p.b.spd + p.b.spe;
			    P[p.id] = p; LISTA.push(p);
			  });
			  var TIPOS = Object.keys(D.tp);
			
			  function ef(a, d) { var x = D.ef[a + '>' + d]; return x === undefined ? 1 : x; }
			  function efTotal(tipo, tiposDef) { return tiposDef.reduce(function (m, d) { return m * ef(tipo, d); }, 1); }
			  function corTipo(t) { return (D.tp[t] || ['', '#888'])[1]; }
			  function nomeTipo(t) { return (D.tp[t] || [t])[0]; }
			  function icone(t, tam) {
			    return `<img class='pk-ico' src='${ICO + t}.svg' title='${nomeTipo(t)}' style='width:${tam || 18}px;height:${tam || 18}px'/>`;
			  }
			  function chip(t) {
			    return `<span class='pk-chip' style='--c:${corTipo(t)}'>${icone(t, 14)}${nomeTipo(t)}</span>`;
			  }
			  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/'/g, '&#39;'); }
			  function fmtEf(x) { return x === 0.5 ? '½' : x === 0.25 ? '¼' : String(x); }
			  function normalizar(s) {
			    return String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]/g, '');
			  }
			  var URL = {
			    sprite: function (id) { return SPR + id + '.png'; },
			    gif: function (id) { return SPR + 'other/showdown/' + id + '.gif'; },
			    costas: function (id) { return SPR + 'other/showdown/back/' + id + '.gif'; },
			    home: function (id) { return SPR + 'other/home/' + id + '.png'; },
			    arte: function (id) { return SPR + 'other/official-artwork/' + id + '.png'; }
			  };
			  /* <img> com cadeia de reserva: se a URL falhar, tenta a próxima */
			  function img(urls, cls, extra) {
			    return `<img class='${cls || ''}' src='${urls[0]}' data-alt='${urls.slice(1).join('|')}' onerror='pkImgErro(this)' ${extra || ''}/>`;
			  }
			  window.pkImgErro = function (el) {
			    var alts = (el.getAttribute('data-alt') || '').split('|').filter(Boolean);
			    if (!alts.length) { el.onerror = null; el.style.visibility = 'hidden'; return; }
			    el.setAttribute('data-alt', alts.slice(1).join('|'));
			    el.src = alts[0];
			  };
			  /* palco fixo de 1280x720 escalado para caber no visual */
			  function escala(raiz) {
			    var palco = raiz.querySelector('.pk-palco');
			    if (!palco) { return; }
			    var w = raiz.clientWidth || window.innerWidth, h = raiz.clientHeight || window.innerHeight;
			    var s = Math.min(w / 1280, h / 720);
			    palco.style.transform = 'translate(' + ((w - 1280 * s) / 2) + 'px,' + ((h - 720 * s) / 2) + 'px) scale(' + s + ')';
			  }
			  function aleatorio(lista) { return lista[Math.floor(Math.random() * lista.length)]; }
			  function embaralhar(lista) {
			    var a = lista.slice();
			    for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var x = a[i]; a[i] = a[j]; a[j] = x; }
			    return a;
			  }
			  /* partículas de fundo por tipo (mesmas classes .fx-<tipo> da Pokédex) */
			  function particulas(tipo, n, semente) {
			    var html = '';
			    for (var i = 1; i <= n; i++) {
			      var k = i + (semente || 0);
			      html += `<i style='left:${(k * 37 + 11) % 100}%;top:${(k * 53 + 7) % 100}%;width:${4 + (k * 7) % 10}"
			& "px;height:${4 + (k * 7) % 10}px;animation-duration:${(5 + ((k * 13) % 60) / 10).toFixed(1)}s;animation-delay:-${(((k * 29) % 80) / 10).toFixed(1)}s'></i>`;
			    }
			    return `<div class='fx fx-${tipo}'>${html}</div>`;
			  }
			
			  window.PK = { v: D.v, D: D, P: P, LISTA: LISTA, TIPOS: TIPOS, ef: ef, efTotal: efTotal, corTipo: corTipo,
			    nomeTipo: nomeTipo, icone: icone, chip: chip, esc: esc, fmtEf: fmtEf, normalizar: normalizar, URL: URL,
			    img: img, escala: escala, aleatorio: aleatorio, embaralhar: embaralhar, particulas: particulas };
			})();
			
			/* Página Quiz: Quem é esse Pokémon? (silhueta, opções ou digitação, dicas, placar).
			   Usa window.PK (comum.js). Não use aspas duplas neste arquivo. */
			(function () {
			  var K = window.PK, raiz = document.getElementById('app-raiz');
			  if (!K || !raiz) { return; }
			  var esc = K.esc, TEMPO = 20;
			  function $(id) { return document.getElementById(id); }
			  function lerRecorde() { try { return +(window.localStorage.getItem('pkQuizRecorde') || 0); } catch (e) { return 0; } }
			  function salvarRecorde(v) { try { window.localStorage.setItem('pkQuizRecorde', String(v)); } catch (e) { /* armazenamento indisponível */ } }
			
			  var S = window.__quiz || (window.__quiz = { modo: 'opcoes', gens: [], pontos: 0, seq: 0, recorde: lerRecorde(), acertos: 0, total: 0,
			    hist: [], atual: null, opcoes: [], dicas: 0, fase: 'pergunta', resposta: null, inicio: 0, restante: TEMPO, timer: null });
			
			  function pool() {
			    return K.LISTA.filter(function (p) { return p.padrao && (!S.gens.length || S.gens.indexOf(p.gen) >= 0); });
			  }
			  function novaRodada() {
			    var lista = pool(); if (!lista.length) { return; }
			    var p = K.aleatorio(lista);
			    var parecidos = lista.filter(function (x) { return x.id !== p.id && (x.gen === p.gen || x.t[0] === p.t[0]); });
			    var outros = K.embaralhar(parecidos.length >= 3 ? parecidos : lista.filter(function (x) { return x.id !== p.id; })).slice(0, 3);
			    S.atual = p.id; S.opcoes = K.embaralhar([p.id].concat(outros.map(function (x) { return x.id; })));
			    S.dicas = 0; S.fase = 'pergunta'; S.resposta = null; S.inicio = Date.now(); S.restante = TEMPO;
			    render(); iniciarTimer();
			    var inp = $('qz-input'); if (inp) { inp.focus(); }
			  }
			  function iniciarTimer() {
			    if (S.timer) { clearInterval(S.timer); }
			    S.timer = setInterval(function () {
			      if (S.fase !== 'pergunta') { clearInterval(S.timer); return; }
			      S.restante = Math.max(0, TEMPO - (Date.now() - S.inicio) / 1000);
			      var b = $('qz-tempo'); if (b) { b.style.width = (100 * S.restante / TEMPO) + '%'; b.className = 'qz-tempo-f' + (S.restante < 6 ? ' pouco' : ''); }
			      var t = $('qz-seg'); if (t) { t.textContent = Math.ceil(S.restante) + 's'; }
			      if (S.restante <= 0) { responder(null); }
			    }, 100);
			  }
			  function responder(id) {
			    if (S.fase !== 'pergunta') { return; }
			    clearInterval(S.timer);
			    var certo = id === S.atual;
			    S.fase = 'revelado'; S.resposta = id; S.total++;
			    if (certo) {
			      S.acertos++; S.seq++;
			      S.ganho = Math.max(10, 100 + Math.round(S.restante) * 5 - S.dicas * 30) + (S.seq >= 3 ? 25 * Math.min(S.seq - 2, 4) : 0);
			      S.pontos += S.ganho;
			      if (S.seq > S.recorde) { S.recorde = S.seq; salvarRecorde(S.recorde); }
			    } else { S.seq = 0; S.ganho = 0; }
			    S.hist.unshift({ id: S.atual, ok: certo }); S.hist = S.hist.slice(0, 12);
			    render();
			  }
			  function letras(nome) {
			    return nome.split('').map(function (c, i) { return i === 0 ? c : /[a-zA-Z0-9]/.test(c) ? '_' : c; }).join(' ');
			  }
			  function dicasHtml(p) {
			    var h = [];
			    if (S.dicas >= 1 || S.fase !== 'pergunta') { h.push(`<span>Tipo: ${p.t.map(K.chip).join('')}</span>`); }
			    if (S.dicas >= 2 || S.fase !== 'pergunta') { h.push(`<span>Geração <b>${p.gen}</b></span>`); }
			    if (S.dicas >= 3 && S.fase === 'pergunta') { h.push(`<span class='qz-letras'>${esc(letras(p.nome))}</span>`); }
			    return h.join('');
			  }
			  function palcoHtml() {
			    if (!S.atual) {
			      return `<div class='qz-ini'><div class='"
			& "qz-logo'>QUEM É ESSE<br/>POKÉMON?</div>
			        <div class='qz-ini-tx'>Descubra o Pokémon pela silhueta. Escolha as gerações e o modo ao lado.</div>
			        <div class='bt bt-go' data-acao='comecar'>▶ COMEÇAR</div></div>`;
			    }
			    var p = K.P[S.atual], rev = S.fase !== 'pergunta', certo = rev && S.resposta === S.atual;
			    var corpo;
			    if (!rev) {
			      if (S.modo === 'opcoes') {
			        corpo = `<div class='qz-ops'>${S.opcoes.map(function (id) { return `<div class='qz-op' data-acao='resp' data-id='${id}'>${esc(K.P[id].nome)}</div>`; }).join('')}</div>`;
			      } else {
			        corpo = `<div class='qz-dig'><input id='qz-input' class='busca' placeholder='Digite o nome e aperte Enter...' autocomplete='off'/>
			          <div class='bt bt-gold' data-acao='enviar'>Responder</div></div>`;
			      }
			      corpo += `<div class='qz-dicas-bt'><div class='bt bt-sec${S.dicas >= 3 ? ' off' : ''}' data-acao='dica'>💡 Dica (${3 - S.dicas}) · −30</div>
			        <div class='bt bt-sec' data-acao='pular'>Pular</div></div>`;
			    } else {
			      var esc1 = S.resposta && S.resposta !== S.atual ? `<span class='qz-errou'>Você respondeu ${esc(K.P[S.resposta] ? K.P[S.resposta].nome : '')}</span>` : S.resposta ? '' : `<span class='qz-errou'>${S.restante <= 0 ? 'Tempo esgotado!' : 'Pulou'}</span>`;
			      corpo = `<div class='qz-res ${certo ? 'ok' : 'erro'}'><div class='qz-res-tit'>${certo ? 'ACERTOU! +' + S.ganho : 'NÃO FOI DESSA VEZ'}</div>${esc1}
			        <div class='bt bt-go' data-acao='proximo'>PRÓXIMO ▸</div></div>`;
			    }
			    return `<div class='qz-tit'>QUEM É ESSE POKÉMON?</div>
			      <div class='qz-silh${rev ? ' rev' : ''}'>${rev ? `<div class='qz-flash'></div>` : ''}${K.img([K.URL.arte(p.id), K.URL.home(p.id)], 'qz-img')}</div>
			      ${rev ? `<div class='qz-nome'>É o <b>${esc(p.nome)}</b>!<span>#${String(p.esp).padStart(3, '0')}</span></div>` : ''}
			      <div class='qz-dicas'>${dicasHtml(p)}</div>
			      ${rev ? '' : `<div class='qz-tempo'><div id='qz-tempo' class='qz-tempo-f' style='width:${100 * S.restante / TEMPO}%'></div><span id='qz-seg'>${Math.ceil(S.restante)}s</span></div>`}
			      ${corpo}`;
			  }
			  function ladoHtml() {
			    var prec = S.total ? Math.round(100 * S.acertos / S.total) : 0;
			    var gens = [1, 2, 3, 4, 5, 6, 7, 8, 9].map(function (g) {
			      return `<span class='gc${S.gens.indexOf(g) >= 0 ? ' on' : ''}' data-acao='gen' data-g='${g}'>${g}</span>`;
			    }).join('');
			    var hist = S.hist.map(function (h) {
			      return `<div class='qz-h ${h.ok ? 'ok' : 'erro'}' title='${esc(K.P[h.id].nome)}'><img src='${K.URL.sprite(h.id)}'/><i>${h.ok ? '✓' : '✗'}</i></div>`;
			    }).join('');
			    return `<div class='qz-placar'>
			        <div class='qz-pts'><span>PONTOS</span><b>${S.pontos.toLocaleString('pt-BR')}</b></div>
			        <div class='qz-mini'><div><span>SEQUÊNCIA</span><b>${S.seq}${S.seq >= 3 ? ' 🔥' : ''}</b></div><div><span>RECORDE</span><b>${S.recorde}</b></div>
			          <div><span>ACERTOS</span><b>${S.acertos}/${S.total}</b></div><div><span>PRECISÃO</span><b>${prec}%</b></div></div></div>
			      <div class='qz-cfg'><div class='qz-cfg-tit'>MODO</div>
			        <div class='modos'><span class='${S.modo === 'opcoes' ? 'on' : ''}' data-acao='modo' data-m='opcoes'>4 opções</span>
			        <span class='${S.modo === 'digitar' ? 'on' : ''}' data-acao='modo' data-m='digitar'>Digitar o nome</span></div>
			        <div class='qz-cfg-tit'>GERAÇÕES <em>${S.gens.length ? pool().length + ' Pokémon' : 'todas · ' + pool().length + ' Pokémon'}</em></div>
			        <div class='gens qz-gens'>${gens}</div></div>
			      <div class='qz-cfg'><div class='qz-cfg-tit'>ÚLTIMAS RESPOSTAS</div><div class='qz-hist'>${hist || `<span class='vazio'>Ainda nada por aqui.</span>`}</div>
			        <div class='bt bt-sec qz-zerar' data-acao='zerar'>↺ Zerar placar</div></div>`;
			  }
			  function render() {
			    raiz.innerHTML = `<div class='pk-palco quiz'>
			      <div class='topo'><span></span><div class='titulo'><b>QUIZ</b><span>teste seu conhecimento</span></div></div>
			      <div class='qz-palc"
			& "o'><div class='qz-raios'></div><div class='qz-conteudo'>${palcoHtml()}</div></div>
			      <div class='qz-lado vidro'>${ladoHtml()}</div></div>`;
			    K.escala(raiz);
			    var inp = $('qz-input');
			    if (inp) {
			      inp.addEventListener('keydown', function (ev) { if (ev.key === 'Enter') { enviarTexto(); } });
			      setTimeout(function () { inp.focus(); }, 30);
			    }
			  }
			  function enviarTexto() {
			    var inp = $('qz-input'); if (!inp) { return; }
			    var v = K.normalizar(inp.value); if (!v) { return; }
			    var p = K.P[S.atual];
			    if (v === K.normalizar(p.nome)) { responder(S.atual); return; }
			    var outro = K.LISTA.find(function (x) { return x.padrao && K.normalizar(x.nome) === v; });
			    responder(outro ? outro.id : -1);
			  }
			  raiz.onclick = function (ev) {
			    var el = ev.target.closest('[data-acao]'); if (!el || el.classList.contains('off')) { return; }
			    switch (el.getAttribute('data-acao')) {
			      case 'comecar': case 'proximo': novaRodada(); break;
			      case 'resp': responder(+el.getAttribute('data-id')); break;
			      case 'enviar': enviarTexto(); break;
			      case 'dica': S.dicas = Math.min(3, S.dicas + 1); render(); break;
			      case 'pular': responder(null); break;
			      case 'modo': S.modo = el.getAttribute('data-m'); if (S.fase === 'pergunta' && S.atual) { render(); } else { render(); } break;
			      case 'gen':
			        var g = +el.getAttribute('data-g'), i = S.gens.indexOf(g);
			        if (i >= 0) { S.gens.splice(i, 1); } else { S.gens.push(g); }
			        render(); break;
			      case 'zerar': S.pontos = 0; S.seq = 0; S.acertos = 0; S.total = 0; S.hist = []; render(); break;
			    }
			  };
			  if (!window.__quizResize) { window.__quizResize = true; window.addEventListener('resize', function () { K.escala(raiz); }); }
			  render();
			  if (S.fase === 'pergunta' && S.atual) { iniciarTimer(); }
			})();
			"
			RETURN
			    "<div id='app-raiz'></div><script>" & _dados & "</script><script>" & _motor & "</script>"
		displayFolder: <HTML>

	measure '<CSS> Quiz' =
			
			"#htmlContent { margin: 0; padding: 0; height: 100vh; overflow: hidden; font-family: 'Segoe UI', sans-serif; color: #E9ECF2; background: #0B0E14; }
			.htmlViewerEntry { height: 100vh; }
			#app-raiz { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #0B0E14; }
			.pk-palco { position: absolute; left: 0; top: 0; width: 1280px; height: 720px; transform-origin: 0 0; overflow: hidden; background: radial-gradient(circle at 50% 30%, #1A2130, #0B0E14 70%); }
			.pk-ico { display: inline-block; vertical-align: middle; border-radius: 50%; }
			.pk-chip { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 800; color: #fff; padding: 2px 9px 2px 3px; border-radius: 999px; background: var(--c); margin: 0 4px 3px 0; text-shadow: 0 1px 1px rgba(0,0,0,.35); }
			.bt { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 34px; padding: 0 18px; border-radius: 999px; font-size: 12px; font-weight: 800; letter-spacing: .05em; cursor: pointer; user-select: none; transition: transform .12s, filter .12s, box-shadow .12s; white-space: nowrap; }
			.bt:hover { transform: translateY(-1px); filter: brightness(1.12); }
			.bt.off { opacity: .35; pointer-events: none; }
			.bt-sec { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); color: #E9ECF2; }
			.bt-sec.on { background: rgba(255,203,5,.16); border-color: #FFCB05; color: #FFCB05; }
			.bt-gold { background: #FFCB05; color: #11151D; box-shadow: 0 0 18px rgba(255,203,5,.35); }
			.bt-go { height: 48px; padding: 0 44px; font-size: 17px; letter-spacing: .14em; background: linear-gradient(90deg, #FF5A36, #FFCB05); color: #11151D; box-shadow: 0 0 28px rgba(255,140,40,.5); animation: pulsa 2s ease-in-out infinite; }
			.bt-go.off { animation: none; }
			@keyframes pulsa { 0%, 100% { box-shadow: 0 0 20px rgba(255,140,40,.4); } 50% { box-shadow: 0 0 38px rgba(255,160,40,.75); } }
			.topo { position: absolute; left: 380px; right: 24px; top: 10px; height: 40px; display: flex; align-items: center; justify-content: space-between; z-index: 5; }
			.titulo { text-align: right; }
			.titulo b { display: block; font-size: 22px; font-weight: 900; letter-spacing: .26em; color: #fff; line-height: 1.1; }
			.titulo span { font-size: 10px; color: #8A93A3; font-weight: 600; letter-spacing: .06em; }
			.vidro { border-radius: 18px; background: linear-gradient(160deg, rgba(30,36,48,.92), rgba(14,17,24,.94)); border: 1px solid rgba(255,255,255,.08); box-shadow: inset 0 1px 0 rgba(255,255,255,.06), 0 18px 40px rgba(0,0,0,.35); }
			::-webkit-scrollbar { width: 6px; height: 6px; } ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.2); border-radius: 6px; } ::-webkit-scrollbar-track { background: transparent; }
			
			/* partículas de fundo por tipo (iguais às da Pokédex) */
			.fx { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
			.fx i { position: absolute; display: block; opacity: 0; animation-iteration-count: infinite; animation-timing-function: linear; }
			.fx-water i, .fx-poison i, .fx-normal i { top: auto !important; bottom: -30px; border-radius: 50%; animation-name: bolha; animation-timing-function: ease-in-out; }
			.fx-water i { border: 1.5px solid rgba(190,215,255,.60); background: radial-gradient(circle at 32% 30%, rgba(255,255,255,.70) 0 12%, rgba(120,160,255,.12) 40%, rgba(104,144,240,.05) 70%); }
			.fx-poison i { border: 1.5px solid rgba(220,150,230,.55); background: radial-gradient(circle at 32% 30%, rgba(255,255,255,.55) 0 12%, rgba(160,64,160,.30) 45%, rgba(160,64,160,.08) 70%); }
			.fx-normal i { background: rgba(255,255,255,.22); }
			@keyframes bolha { 0% { transform: translate(0,0) scale(.7); opacity: 0; } 10% { opacity: .9; } 50% { transform: translate(18px,-380px) scale(1.2); } 90% { opacity: .8; } 100% { transform: translate(-10px,-780px) scale(1.5); opacity: 0; } }
			.fx-fire i { top: auto !important; bottom: -10px; width: 4px !important; height: 4px !important; border-radius: 50%; background: #FFD27A; box-shadow: 0 0 6px 2px rgba(255,"
			& "140,40,.85), 0 0 14px 4px rgba(255,80,20,.35); animation-name: brasa; animation-timing-function: ease-out; }
			@keyframes brasa { 0% { transform: translate(0,0) scale(1); opacity: 0; } 8% { opacity: 1; } 30% { transform: translate(-14px,-200px) scale(.9); } 60% { transform: translate(16px,-420px) scale(.7); opacity: .9; } 100% { transform: translate(-6px,-680px) scale(.2); opacity: 0; } }
			.fx-electric i { width: 18px !important; height: 50px !important; filter: drop-shadow(0 0 6px rgba(248,208,48,.95)); animation-name: raiofx; animation-timing-function: steps(1, end); }
			.fx-electric i::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, #FFFBD0, #F8D030); clip-path: polygon(55% 0, 18% 56%, 45% 56%, 28% 100%, 86% 40%, 58% 40%, 76% 0); }
			@keyframes raiofx { 0%, 100% { opacity: 0; } 3% { opacity: 1; } 5% { opacity: .1; } 7% { opacity: 1; } 10% { opacity: 0; } }
			.fx-grass i, .fx-ice i, .fx-rock i { top: -30px !important; animation-timing-function: ease-in-out; }
			.fx-grass i { width: 10px !important; height: 16px !important; border-radius: 0 100% 0 100%; background: linear-gradient(135deg, #A8E68A, #4E9A2F); animation-name: folhafx; }
			.fx-ice i { border-radius: 50%; background: #fff; box-shadow: 0 0 8px rgba(200,240,255,.9); max-width: 8px; max-height: 8px; animation-name: neve; }
			.fx-rock i { background: #B8A038; clip-path: polygon(20% 0, 80% 10%, 100% 60%, 60% 100%, 0 70%); animation-name: pedrafx; animation-timing-function: cubic-bezier(.5,0,1,1); }
			@keyframes folhafx { 0% { transform: translate(0,0) rotate(0); opacity: 0; } 10% { opacity: .85; } 50% { transform: translate(-60px,380px) rotate(200deg); } 90% { opacity: .7; } 100% { transform: translate(40px,780px) rotate(420deg); opacity: 0; } }
			@keyframes neve { 0% { transform: translate(0,0); opacity: 0; } 10% { opacity: .9; } 50% { transform: translate(30px,380px); } 100% { transform: translate(-20px,780px); opacity: 0; } }
			@keyframes pedrafx { 0% { transform: translate(0,0) rotate(0); opacity: 0; } 5% { opacity: .8; } 100% { transform: translate(20px,780px) rotate(360deg); opacity: .5; } }
			.fx-ghost i { top: auto !important; bottom: -60px; width: 46px !important; height: 46px !important; border-radius: 50%; background: radial-gradient(circle, rgba(170,140,230,.55), rgba(112,88,152,0) 70%); filter: blur(2px); animation-name: alma; animation-timing-function: ease-in-out; }
			@keyframes alma { 0% { transform: translate(0,0) scale(.6); opacity: 0; } 20% { opacity: .85; } 50% { transform: translate(40px,-360px) scale(1.2); } 80% { opacity: .5; } 100% { transform: translate(-30px,-760px) scale(.8); opacity: 0; } }
			.fx-psychic i, .fx-fighting i { width: 30px !important; height: 30px !important; border-radius: 50%; border: 2px solid rgba(248,88,136,.70); animation-name: pulsofx; animation-timing-function: ease-out; }
			.fx-fighting i { border-color: rgba(255,120,60,.70); }
			@keyframes pulsofx { 0% { transform: scale(.2); opacity: 0; } 10% { opacity: .9; } 100% { transform: scale(4); opacity: 0; } }
			.fx-flying i { width: 110px !important; height: 2px !important; border-radius: 2px; background: linear-gradient(90deg, transparent, rgba(225,225,255,.65), transparent); animation-name: ventofx; animation-timing-function: ease-in-out; }
			.fx-ground i { border-radius: 50%; background: rgba(224,192,104,.55); filter: blur(1px); animation-name: poeirafx; }
			.fx-dark i { width: 90px !important; height: 90px !important; border-radius: 50%; background: radial-gradient(circle, rgba(70,50,50,.60), transparent 70%); filter: blur(4px); animation-name: fumaca; animation-timing-function: ease-in-out; }
			@keyframes ventofx { 0% { transform: translateX(-300px); opacity: 0; } 20% { opacity: .8; } 100% { transform: translateX(500px); opacity: 0; } }
			@keyframes poeirafx { 0% { transform: translate(-40px,0); opacity: 0; } 20% { opacity: .7; } 100% { transform: translate(260px,-60px); opacity: 0; } }
			@keyframes fumaca { 0% { transform: translate(0,0) scale(.6); opacity: 0; } 30% { opa"
			& "city: .7; } 100% { transform: translate(120px,-140px) scale(1.6); opacity: 0; } }
			.fx-fairy i, .fx-dragon i, .fx-steel i { width: 12px !important; height: 12px !important; clip-path: polygon(50% 0, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0 50%, 39% 39%); animation-name: brilhofx; animation-timing-function: ease-in-out; }
			.fx-fairy i { background: #FFD6E8; } .fx-dragon i { background: #B9A2FF; } .fx-steel i { background: #EEF3FA; }
			.fx-bug i { width: 5px !important; height: 5px !important; border-radius: 50%; background: #E6F57A; box-shadow: 0 0 10px 3px rgba(200,230,80,.70); animation-name: vagalume; animation-timing-function: ease-in-out; }
			@keyframes brilhofx { 0%, 100% { transform: scale(0) rotate(0); opacity: 0; } 50% { transform: scale(1.4) rotate(90deg); opacity: 1; } }
			@keyframes vagalume { 0% { transform: translate(0,0); opacity: 0; } 25% { transform: translate(30px,-20px); opacity: 1; } 50% { transform: translate(-10px,-50px); opacity: .3; } 75% { transform: translate(-40px,-10px); opacity: 1; } 100% { transform: translate(0,0); opacity: 0; } }
			
			/* controles compartilhados (abas, gerações) */
			.modos { display: flex; gap: 6px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.10); padding: 4px; border-radius: 999px; }
			.modos span { padding: 6px 16px; border-radius: 999px; font-size: 11px; font-weight: 800; color: #C9CFDA; cursor: pointer; white-space: nowrap; transition: background .12s, color .12s; }
			.modos span:hover { color: #fff; background: rgba(255,255,255,.06); }
			.modos span.on { background: #FFCB05; color: #11151D; box-shadow: 0 0 14px rgba(255,203,5,.35); }
			.gens { display: flex; gap: 4px; }
			.gc { flex: 1; text-align: center; font-size: 10px; font-weight: 800; padding: 4px 0; border-radius: 999px; cursor: pointer; color: #C9CFDA; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); }
			.gc:hover { color: #fff; border-color: rgba(255,255,255,.25); }
			.gc.on { background: #FFCB05; color: #11151D; border-color: #FFCB05; }
			.topo { left: 452px; }
			
			.quiz { background: #0B0E14; }
			.qz-palco { position: absolute; left: 16px; top: 60px; width: 852px; height: 644px; border-radius: 22px; overflow: hidden; background: radial-gradient(circle at 50% 42%, #5AA8FF, #1E5BD8 45%, #0C2C7A 85%); border: 1px solid rgba(255,255,255,.12); box-shadow: 0 18px 40px rgba(0,0,0,.45); }
			.qz-raios { position: absolute; left: 50%; top: 42%; width: 1500px; height: 1500px; margin: -750px 0 0 -750px; background: repeating-conic-gradient(rgba(255,214,10,.30) 0 7deg, transparent 7deg 18deg); -webkit-mask-image: radial-gradient(circle, #000 10%, transparent 60%); animation: girar 40s linear infinite; }
			@keyframes girar { to { transform: rotate(360deg); } }
			.qz-conteudo { position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; align-items: center; padding: 18px 30px; box-sizing: border-box; }
			.qz-tit, .qz-logo { font-size: 34px; font-weight: 900; font-style: italic; color: #FFCB05; -webkit-text-stroke: 3px #1D3A8A; text-shadow: 0 5px 0 #1D3A8A, 0 0 26px rgba(255,203,5,.4); letter-spacing: .02em; text-align: center; line-height: 1.05; }
			.qz-ini { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; }
			.qz-logo { font-size: 72px; -webkit-text-stroke: 5px #1D3A8A; text-shadow: 0 8px 0 #1D3A8A, 0 0 40px rgba(255,203,5,.5); animation: flut 3s ease-in-out infinite; }
			.qz-ini-tx { font-size: 14px; font-weight: 700; color: #fff; text-shadow: 0 2px 6px rgba(0,0,0,.5); }
			.qz-silh { position: relative; width: 300px; height: 300px; margin-top: 4px; display: flex; align-items: center; justify-content: center; }
			.qz-img { width: 290px; height: 290px; object-fit: contain; filter: brightness(0) drop-shadow(0 0 2px rgba(255,255,255,.35)); transition: filter .6s ease; }
			.qz-silh.rev .qz-img { filter: drop-shadow(0 14px 18px rgba(0,0,0,.45)); animation: revela .6s ease-out; }
			@keyframes revela { 0% { transform: scale(.9); filter: bright"
			& "ness(0); } 40% { filter: brightness(3); } 100% { transform: scale(1); } }
			.qz-flash { position: absolute; inset: -60px; border-radius: 50%; background: radial-gradient(circle, #fff, rgba(255,255,255,0) 65%); animation: flashq .7s ease-out forwards; pointer-events: none; }
			@keyframes flashq { from { opacity: 1; transform: scale(.5); } to { opacity: 0; transform: scale(1.3); } }
			.qz-nome { margin-top: 4px; font-size: 22px; font-weight: 800; color: #fff; text-shadow: 0 2px 8px rgba(0,0,0,.5); display: flex; align-items: baseline; gap: 10px; animation: msg .4s ease-out; }
			.qz-nome b { font-size: 34px; font-weight: 900; font-style: italic; color: #FFCB05; -webkit-text-stroke: 2px #1D3A8A; }
			.qz-nome span { font-size: 14px; color: rgba(255,255,255,.75); }
			.qz-dicas { min-height: 26px; margin: 6px 0; display: flex; gap: 12px; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #fff; }
			.qz-dicas > span { display: flex; align-items: center; gap: 6px; background: rgba(8,20,60,.55); padding: 3px 12px; border-radius: 999px; }
			.qz-letras { font-family: Consolas, monospace; font-size: 16px; letter-spacing: .1em; }
			.qz-tempo { position: relative; width: 520px; height: 12px; border-radius: 999px; background: rgba(0,0,0,.35); overflow: hidden; margin: 2px 0 12px; }
			.qz-tempo-f { height: 100%; border-radius: 999px; background: linear-gradient(90deg, #22C55E, #FDE047); transition: width .1s linear; }
			.qz-tempo-f.pouco { background: linear-gradient(90deg, #DC2626, #F87171); }
			.qz-tempo span { position: absolute; right: 8px; top: -1px; font-size: 10px; font-weight: 900; color: #fff; }
			.qz-ops { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 640px; }
			.qz-op { height: 50px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 17px; font-weight: 900; color: #1D3A8A; background: linear-gradient(180deg, #FFFFFF, #DCE7FF); border: 3px solid #1D3A8A; box-shadow: 0 5px 0 #1D3A8A; cursor: pointer; transition: transform .1s, box-shadow .1s; }
			.qz-op:hover { transform: translateY(-2px); box-shadow: 0 7px 0 #1D3A8A; background: linear-gradient(180deg, #FFF6C2, #FFCB05); }
			.qz-op:active { transform: translateY(3px); box-shadow: 0 2px 0 #1D3A8A; }
			.qz-dig { display: flex; gap: 10px; width: 560px; }
			.qz-dig .busca { flex: 1; height: 50px; font-size: 16px; background: rgba(255,255,255,.95); color: #11151D; border: 3px solid #1D3A8A; }
			.qz-dig .bt { height: 50px; }
			.qz-dicas-bt { display: flex; gap: 10px; margin-top: 12px; }
			.qz-dicas-bt .bt-sec { background: rgba(8,20,60,.55); }
			.qz-res { display: flex; flex-direction: column; align-items: center; gap: 10px; animation: msg .4s ease-out; }
			.qz-res-tit { font-size: 34px; font-weight: 900; font-style: italic; -webkit-text-stroke: 2px #11151D; }
			.qz-res.ok .qz-res-tit { color: #4ADE80; text-shadow: 0 0 24px rgba(74,222,128,.6); }
			.qz-res.erro .qz-res-tit { color: #F87171; }
			.qz-errou { font-size: 13px; font-weight: 700; color: #fff; background: rgba(8,20,60,.55); padding: 3px 12px; border-radius: 999px; }
			@keyframes msg { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
			@keyframes flut { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
			.qz-lado { position: absolute; left: 884px; top: 60px; width: 380px; height: 644px; box-sizing: border-box; padding: 16px; display: flex; flex-direction: column; gap: 14px; }
			.qz-placar { display: flex; flex-direction: column; gap: 10px; }
			.qz-pts { padding: 12px 16px; border-radius: 16px; background: linear-gradient(120deg, #1D3A8A, #2563EB); box-shadow: 0 0 24px rgba(37,99,235,.35); display: flex; justify-content: space-between; align-items: center; }
			.qz-pts span { font-size: 11px; font-weight: 900; letter-spacing: .2em; color: #BFD3FF; }
			.qz-pts b { font-size: 34px; font-weight: 900; color: #FFCB05; }
			.qz-mini { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
			.qz-mini div { padding: 8px 12px; border-radius: 12px;"
			& " background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); }
			.qz-mini span { display: block; font-size: 9px; font-weight: 900; letter-spacing: .16em; color: #8A93A3; }
			.qz-mini b { font-size: 20px; font-weight: 900; color: #fff; }
			.qz-cfg { display: flex; flex-direction: column; gap: 8px; }
			.qz-cfg-tit { font-size: 10px; font-weight: 900; letter-spacing: .18em; color: #8A93A3; display: flex; justify-content: space-between; }
			.qz-cfg-tit em { font-style: normal; letter-spacing: 0; color: #5C6575; font-weight: 700; }
			.qz-cfg .modos { align-self: flex-start; }
			.modos { display: flex; gap: 6px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.10); padding: 4px; border-radius: 999px; }
			.modos span { padding: 6px 16px; border-radius: 999px; font-size: 11px; font-weight: 800; color: #C9CFDA; cursor: pointer; }
			.modos span.on { background: #FFCB05; color: #11151D; }
			.gens { display: flex; gap: 4px; }
			.gc { flex: 1; text-align: center; font-size: 11px; font-weight: 800; padding: 5px 0; border-radius: 999px; cursor: pointer; color: #C9CFDA; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); }
			.gc.on { background: #FFCB05; color: #11151D; border-color: #FFCB05; }
			.qz-hist { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
			.qz-h { position: relative; height: 52px; border-radius: 10px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); display: flex; align-items: center; justify-content: center; }
			.qz-h img { width: 48px; height: 48px; image-rendering: pixelated; }
			.qz-h i { position: absolute; right: 3px; top: 1px; font-style: normal; font-size: 11px; font-weight: 900; }
			.qz-h.ok { border-color: rgba(74,222,128,.5); } .qz-h.ok i { color: #4ADE80; }
			.qz-h.erro { border-color: rgba(248,113,113,.5); } .qz-h.erro i { color: #F87171; }
			.qz-zerar { align-self: flex-start; height: 28px; font-size: 11px; }
			.vazio { font-size: 11px; color: #5C6575; grid-column: 1 / -1; }
			"
		displayFolder: <HTML>\CSS

	measure '<HTML> Safari' =
			
			VAR _dados = [JS Dados]
			VAR _motor =
			"/* Base compartilhada das páginas em JavaScript (Arena, Tipos, Quiz).
			   Lê window.ARENA_DADOS (medida DAX [JS Dados]) e publica window.PK com dados e utilidades.
			     pk: [id, nome, especie, tipo1, tipo2, hp, atk, def, spa, spd, spe, padrao, geracao, lendario/mítico]
			     ef: { 'ataque>defesa': fator }   gp: golpes   tp: { slug: [nome PT, cor] }
			   Não use aspas duplas neste arquivo (ele vira uma string DAX). */
			(function () {
			  var D = window.ARENA_DADOS;
			  if (!D) { return; }
			  if (window.PK && window.PK.v === D.v) { return; }
			
			  var SPR = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/';
			  var ICO = 'https://raw.githubusercontent.com/partywhale/pokemon-type-icons/main/icons/';
			  var P = {}, LISTA = [];
			  D.pk.forEach(function (r) {
			    var p = { id: r[0], nome: r[1], esp: r[2], t: r[4] ? [r[3], r[4]] : [r[3]],
			      b: { hp: r[5], atk: r[6], def: r[7], spa: r[8], spd: r[9], spe: r[10] }, padrao: r[11] === 1, gen: r[12] || 0, lend: r[13] === 1 };
			    p.total = p.b.hp + p.b.atk + p.b.def + p.b.spa + p.b.spd + p.b.spe;
			    P[p.id] = p; LISTA.push(p);
			  });
			  var TIPOS = Object.keys(D.tp);
			
			  function ef(a, d) { var x = D.ef[a + '>' + d]; return x === undefined ? 1 : x; }
			  function efTotal(tipo, tiposDef) { return tiposDef.reduce(function (m, d) { return m * ef(tipo, d); }, 1); }
			  function corTipo(t) { return (D.tp[t] || ['', '#888'])[1]; }
			  function nomeTipo(t) { return (D.tp[t] || [t])[0]; }
			  function icone(t, tam) {
			    return `<img class='pk-ico' src='${ICO + t}.svg' title='${nomeTipo(t)}' style='width:${tam || 18}px;height:${tam || 18}px'/>`;
			  }
			  function chip(t) {
			    return `<span class='pk-chip' style='--c:${corTipo(t)}'>${icone(t, 14)}${nomeTipo(t)}</span>`;
			  }
			  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/'/g, '&#39;'); }
			  function fmtEf(x) { return x === 0.5 ? '½' : x === 0.25 ? '¼' : String(x); }
			  function normalizar(s) {
			    return String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]/g, '');
			  }
			  var URL = {
			    sprite: function (id) { return SPR + id + '.png'; },
			    gif: function (id) { return SPR + 'other/showdown/' + id + '.gif'; },
			    costas: function (id) { return SPR + 'other/showdown/back/' + id + '.gif'; },
			    home: function (id) { return SPR + 'other/home/' + id + '.png'; },
			    arte: function (id) { return SPR + 'other/official-artwork/' + id + '.png'; }
			  };
			  /* <img> com cadeia de reserva: se a URL falhar, tenta a próxima */
			  function img(urls, cls, extra) {
			    return `<img class='${cls || ''}' src='${urls[0]}' data-alt='${urls.slice(1).join('|')}' onerror='pkImgErro(this)' ${extra || ''}/>`;
			  }
			  window.pkImgErro = function (el) {
			    var alts = (el.getAttribute('data-alt') || '').split('|').filter(Boolean);
			    if (!alts.length) { el.onerror = null; el.style.visibility = 'hidden'; return; }
			    el.setAttribute('data-alt', alts.slice(1).join('|'));
			    el.src = alts[0];
			  };
			  /* palco fixo de 1280x720 escalado para caber no visual */
			  function escala(raiz) {
			    var palco = raiz.querySelector('.pk-palco');
			    if (!palco) { return; }
			    var w = raiz.clientWidth || window.innerWidth, h = raiz.clientHeight || window.innerHeight;
			    var s = Math.min(w / 1280, h / 720);
			    palco.style.transform = 'translate(' + ((w - 1280 * s) / 2) + 'px,' + ((h - 720 * s) / 2) + 'px) scale(' + s + ')';
			  }
			  function aleatorio(lista) { return lista[Math.floor(Math.random() * lista.length)]; }
			  function embaralhar(lista) {
			    var a = lista.slice();
			    for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var x = a[i]; a[i] = a[j]; a[j] = x; }
			    return a;
			  }
