			  function elipse(c, x, y, rx, ry, cor) { c.fillStyle = cor; c.beginPath(); c.ellipse(x, y, rx, ry, 0, 0, Math.PI * 2); c.fill(); }
			  var COR = { k: '#1F2028', r: '#E8383D', R: '#A51D22', w: '#F8F8F8', s: '#F8C898', h: '#5A3418', b: '#3A78E0', B: '#2650A8', g: '#3C4458', y: '#F8D030' };
