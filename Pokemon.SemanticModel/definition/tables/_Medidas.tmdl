	measure '<CSS> Formas Item' = ```

			[<CSS> Tipos] & "
			#htmlContent { margin: 0; padding: 0 0 4px; height: 100vh; box-sizing: border-box; display: flex; align-items: center; gap: 6px; overflow-x: auto; overflow-y: hidden; font-family: 'Segoe UI', sans-serif; }
			#htmlContent::-webkit-scrollbar { height: 5px; }
			#htmlContent::-webkit-scrollbar-thumb { background: rgba(255,255,255,.18); border-radius: 5px; }
			.htmlViewerEntry { flex: 0 0 auto; }
			.fm { width: 86px; display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 4px 2px 6px; border-radius: 14px; cursor: pointer; transition: background .15s, transform .15s; }
			.htmlViewerEntry:hover .fm { background: rgba(255,255,255,.06); transform: translateY(-2px); }
			.fm-img { width: 62px; height: 62px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
			.fm-img img { max-width: 56px; max-height: 56px; }
			.fm span { max-width: 82px; font-size: 10px; font-weight: 700; color: #C9CFDA; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.fm-atual { background: rgba(255,255,255,.07); box-shadow: inset 0 0 0 1px rgba(255,255,255,.20); }
			.fm-atual span { color: #fff; }
			.htmlViewerEntry.unselected .fm { opacity: .35; }
			#statusMessage div { display: none; }
			"
